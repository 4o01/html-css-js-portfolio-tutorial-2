<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Spotify - Get 3 Months Free Premium</title>
<link rel="icon" href="https://open.spotifycdn.com/cdn/images/favicon32.b64ecc03.png">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Circular', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #121212; min-height: 100vh; display: flex; flex-direction: column; color: #fff; }
.header { padding: 24px 32px; display: flex; align-items: center; }
.header svg { width: 40px; height: 40px; }
.header span { font-size: 20px; font-weight: 700; margin-right: 8px; }
.main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
.container { width: 100%; max-width: 460px; }
.promo-banner { background: linear-gradient(135deg, #1DB954, #1ed760); border-radius: 16px; padding: 32px; text-align: center; margin-bottom: 24px; position: relative; overflow: hidden; }
.promo-banner::before { content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200"><circle cx="20" cy="20" r="3" fill="rgba(255,255,255,0.1)"/><circle cx="80" cy="60" r="2" fill="rgba(255,255,255,0.08)"/><circle cx="140" cy="30" r="4" fill="rgba(255,255,255,0.06)"/><circle cx="180" cy="80" r="2" fill="rgba(255,255,255,0.1)"/><circle cx="40" cy="120" r="3" fill="rgba(255,255,255,0.07)"/><circle cx="160" cy="150" r="5" fill="rgba(255,255,255,0.05)"/></svg>'); }
.promo-title { font-size: 28px; font-weight: 800; margin-bottom: 8px; position: relative; z-index: 1; }
.promo-sub { font-size: 16px; opacity: 0.9; position: relative; z-index: 1; margin-bottom: 16px; }
.wave-container { display: flex; align-items: flex-end; justify-content: center; gap: 4px; height: 40px; position: relative; z-index: 1; }
.wave-bar { width: 6px; background: rgba(255,255,255,0.8); border-radius: 3px; animation: wave 1.2s ease-in-out infinite; }
.wave-bar:nth-child(1) { height: 12px; animation-delay: 0s; }
.wave-bar:nth-child(2) { height: 24px; animation-delay: 0.1s; }
.wave-bar:nth-child(3) { height: 36px; animation-delay: 0.2s; }
.wave-bar:nth-child(4) { height: 20px; animation-delay: 0.3s; }
.wave-bar:nth-child(5) { height: 30px; animation-delay: 0.4s; }
.wave-bar:nth-child(6) { height: 16px; animation-delay: 0.5s; }
.wave-bar:nth-child(7) { height: 28px; animation-delay: 0.6s; }
.wave-bar:nth-child(8) { height: 22px; animation-delay: 0.7s; }
@keyframes wave { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.4); } }
.features { display: flex; gap: 12px; justify-content: center; margin-top: 16px; position: relative; z-index: 1; }
.feature { background: rgba(0,0,0,0.2); border-radius: 20px; padding: 6px 14px; font-size: 12px; font-weight: 600; }
.login-box { background: #282828; border-radius: 8px; padding: 32px; }
.login-box h2 { font-size: 28px; font-weight: 700; margin-bottom: 8px; text-align: center; }
.login-box p { font-size: 14px; color: #b3b3b3; margin-bottom: 24px; text-align: center; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 14px; font-weight: 700; margin-bottom: 8px; }
.form-group input { width: 100%; padding: 14px 16px; border: 1px solid #727272; border-radius: 4px; font-size: 16px; color: #fff; background: #121212; outline: none; transition: border-color 0.2s; }
.form-group input:focus { border-color: #1DB954; box-shadow: 0 0 0 2px rgba(29,185,84,0.3); }
.form-group input::placeholder { color: #727272; }
.remember { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
.remember input[type="checkbox"] { width: 16px; height: 16px; accent-color: #1DB954; }
.remember label { font-size: 14px; color: #b3b3b3; cursor: pointer; }
.btn-login { width: 100%; padding: 14px; background: #1DB954; color: #000; border: none; border-radius: 500px; font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.2s; }
.btn-login:hover { background: #1ed760; transform: scale(1.02); }
.divider { display: flex; align-items: center; margin: 24px 0; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #727272; }
.divider span { padding: 0 16px; color: #b3b3b3; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
.social-btns { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
.social-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px; border: 1px solid #727272; border-radius: 500px; font-size: 14px; font-weight: 700; color: #fff; cursor: pointer; background: transparent; text-decoration: none; transition: border-color 0.2s; }
.social-btn:hover { border-color: #fff; }
.signup-link { text-align: center; color: #b3b3b3; font-size: 14px; }
.signup-link a { color: #fff; text-decoration: underline; font-weight: 600; }
.loading { display: none; text-align: center; padding: 32px; }
.spinner { border: 3px solid #282828; border-top: 3px solid #1DB954; border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer { text-align: center; padding: 24px; font-size: 12px; color: #727272; }
@media (max-width: 500px) { .container { padding: 0 16px; } .promo-banner, .login-box { padding: 24px 20px; } .promo-title { font-size: 22px; } }
</style>
</head>
